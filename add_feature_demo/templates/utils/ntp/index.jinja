{% extends "layout_main.jinja" %}

{% block title %}{{ page_title }}{% endblock %}

{% block caption %}{{ page_title }}{% endblock %}

{% block inner %}
    <!-- Success/Error Messages -->
    {% if request.query_params.get('message') %}
    <div class="bg-success-900/30 border-2 border-success-500/50 text-success-400 px-4 py-3 rounded mb-4">
        {{ request.query_params.get('message') }}
    </div>
    {% endif %}

    {% if request.query_params.get('error') %}
    <div class="bg-danger-900/30 border-2 border-danger-500/50 text-danger-400 px-4 py-3 rounded mb-4">
        <strong>Error:</strong> {{ request.query_params.get('error') }}
    </div>
    {% endif %}

    <!-- Service Status (refreshed in place via HTMX) -->
    <div id="status-container" class="bg-bg-elevated rounded-lg p-4 mb-6">
        {% include "utils/ntp/status_partial.jinja" %}
    </div>

    <!-- NTP Servers -->
    <div class="mb-6">
        <h3 class="text-lg font-semibold text-text-primary mb-3">Configured NTP Servers</h3>

        {% if servers %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-border-subtle">
                <thead class="bg-bg-base">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-text-tertiary uppercase tracking-wider">
                            Server Address
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle">
                    {% for server in servers %}
                    <tr>
                        <td class="px-4 py-3 whitespace-nowrap text-sm font-mono text-text-primary">
                            {{ server }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="text-text-secondary">No NTP servers configured.</p>
        {% endif %}
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3">
        <a href="/utils/ntp/config" class="btn-primary px-4 py-2 inline-flex items-center">
            Edit Configuration
        </a>

        <form method="POST" action="/utils/ntp/service/restart" class="inline">
            <button type="submit"
                    class="btn-secondary px-4 py-2"
                    onclick="return confirm('Restart NTP service?');">
                Restart Service
            </button>
        </form>

        <form method="POST" action="/utils/ntp/service/enable" class="inline">
            <button type="submit" class="btn-secondary px-4 py-2">
                Enable at Boot
            </button>
        </form>

        <button hx-get="/utils/ntp/status/refresh"
                hx-target="#status-container"
                hx-swap="innerHTML"
                class="btn-secondary px-4 py-2">
            Refresh Status
        </button>
    </div>
{% endblock %}
