{% extends "layout_main.jinja" %}

{% block title %}{{ page_title }}{% endblock %}

{% block caption %}{{ page_title }}{% endblock %}

{% block inner %}
    <!-- Success/Error Messages -->
    {% if request.query_params.get('message') %}
    <div class="bg-success-900/30 border-2 border-success-500/50 text-success-400 px-4 py-3 rounded mb-4">
        {{ request.query_params.get('message') }}
    </div>
    {% endif %}

    {% if request.query_params.get('error') %}
    <div class="bg-danger-900/30 border-2 border-danger-500/50 text-danger-400 px-4 py-3 rounded mb-4">
        <strong>Error:</strong> {{ request.query_params.get('error') }}
    </div>
    {% endif %}

    <p class="text-text-secondary mb-4">
        Configuration file: <span class="font-mono text-text-primary">{{ config_path }}</span>
    </p>

    <form method="POST" action="/utils/ntp/config/save">
        <div class="mb-4">
            <label for="config" class="block text-sm font-medium text-text-secondary mb-2">
                Configuration Content
            </label>
            <textarea
                name="config"
                id="config"
                rows="20"
                class="form-textarea w-full font-mono text-sm"
                required>{{ config }}</textarea>
            <p class="mt-2 text-sm text-text-tertiary">
                Edit the NTP configuration file. Incorrect syntax may prevent the service from starting.
            </p>
        </div>
        <div class="flex gap-3">
            <button type="submit"
                    class="btn-primary px-4 py-2"
                    onclick="return confirm('Save NTP configuration? The service will need to be restarted for changes to take effect.');">
                Save Configuration
            </button>

            <a href="/utils/ntp" class="btn-secondary px-4 py-2 inline-flex items-center">
                Cancel
            </a>
        </div>
    </form>

    <!-- Help -->
    <div class="mt-6 bg-info-900/30 border-2 border-info-500/50 text-info-400 px-4 py-3 rounded">
        <h3 class="text-sm font-semibold mb-2">Configuration Help</h3>
        <p class="text-sm mb-2">Common NTP configuration directives:</p>
        <ul class="list-disc list-inside text-sm space-y-1">
            <li><code>server [address]</code> - Add an NTP server</li>
            <li><code>pool [address]</code> - Add a pool of NTP servers</li>
            <li><code>driftfile [path]</code> - Specify drift file location</li>
            <li><code>restrict [options]</code> - Set access restrictions</li>
        </ul>
        <p class="text-sm mt-2">Restart the NTP service after making changes.</p>
    </div>
{% endblock %}
