<h3 class="text-lg font-semibold text-text-primary mb-4">Service Status</h3>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Service Status -->
    <div>
        <div class="flex items-center mb-2">
            <span class="text-sm font-medium text-text-secondary">Service:</span>
            <span class="ml-2 text-sm font-mono text-text-primary">{{ status.service_name }}</span>
        </div>
        <div class="flex items-center mb-2">
            <span class="text-sm font-medium text-text-secondary">Status:</span>
            {% if status.running %}
            <span class="ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-success-900/30 text-success-400 border border-success-500/50">
                Running
            </span>
            {% else %}
            <span class="ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-danger-900/30 text-danger-400 border border-danger-500/50">
                Stopped
            </span>
            {% endif %}
        </div>
        <div class="flex items-center">
            <span class="text-sm font-medium text-text-secondary">OS:</span>
            <span class="ml-2 text-sm text-text-primary">{{ status.os_type }}</span>
        </div>
    </div>

    <!-- Time Information -->
    <div>
        <div class="mb-2">
            <span class="text-sm font-medium text-text-secondary">System Time:</span>
            <p class="text-sm font-mono text-text-primary mt-1">{{ time_info.system_time }}</p>
        </div>
    </div>
</div>

<!-- Sync Status Details -->
<div class="mt-4">
    <h4 class="text-sm font-medium text-text-secondary mb-2">Sync Status:</h4>
    <pre class="bg-bg-base border border-border-subtle rounded p-3 text-xs text-text-secondary overflow-x-auto">{{ time_info.sync_status }}</pre>
</div>
