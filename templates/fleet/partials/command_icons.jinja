{% macro icon(path) -%}
<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ path }}"/></svg>
{%- endmacro %}

{# Horizontal bar; segments is a list of (percent, level) pairs. #}
{% macro bar(segments) -%}
<div class="cc-bar">{% for width, level in segments %}<i class="cc-f-{{ level }}" style="width: {{ [[width, 0]|max, 100]|min }}%"></i>{% endfor %}</div>
{%- endmacro %}
