{% extends "layout_main.jinja" %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="container-page max-w-7xl">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-3">
            <a href="/zfs/replication/history" class="text-text-secondary hover:text-text-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </a>
            <h1 class="text-3xl font-bold text-text-primary mb-0">Execution #{{ execution.id }} - {{ execution.job_name }}</h1>
            {% if execution.status == 'running' %}
                <span class="badge-warning animate-pulse">Running</span>
            {% elif execution.status == 'success' %}
                <span class="badge-success">Completed</span>
            {% elif execution.status == 'failure' %}
                <span class="badge-danger">Failed</span>
            {% endif %}
        </div>
        {% if execution.status == 'running' %}
        <form method="post" action="/zfs/replication/history/{{ execution.id }}/mark-failed"
              onsubmit="return confirm('Are you sure you want to mark this execution as failed? Only do this if the replication process is no longer running.');">
            <button type="submit" class="btn-danger btn-sm inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Mark as Failed
            </button>
        </form>
        {% endif %}
    </div>

    {% if request.query_params.get('message') %}
    <div class="card mb-6 border border-success-900/30 bg-success-900/10">
        <div class="px-6 py-3 text-success-400">{{ request.query_params.get('message') }}</div>
    </div>
    {% endif %}
    {% if request.query_params.get('error') %}
    <div class="card mb-6 border border-danger-900/30 bg-danger-900/10">
        <div class="px-6 py-3 text-danger-400">{{ request.query_params.get('error') }}</div>
    </div>
    {% endif %}

    {% if execution.receive_resume_token %}
    <!-- Resumable receive state (issue #7) -->
    <div class="card mb-6">
        <div class="px-6 py-4 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary flex items-center">
                <svg class="w-5 h-5 mr-2 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Resumable Receive State
            </h2>
        </div>
        <div class="p-6 space-y-4">
            <p class="text-text-secondary text-sm">
                This receive was started with <code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">-s</code>
                and its partial stream is still saved on the receiving side. Resume continues the transfer with
                <code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">zfs send -t</code>; discard aborts it with
                <code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">zfs receive -A</code> and destroys the
                partially received dataset.
            </p>

            <div>
                <div class="text-sm text-text-tertiary mb-1">Receive Target</div>
                <div class="font-mono text-sm text-success-400">{{ execution.receive_resume_target }}</div>
                {% if execution.receive_resume_target != execution.target_dataset %}
                <p class="text-text-tertiary text-xs mt-1">
                    The saved state belongs to this dataset, not the selected target
                    <span class="font-mono">{{ execution.target_dataset }}</span>.
                </p>
                {% endif %}
            </div>

            <div>
                <div class="text-sm text-text-tertiary mb-1">receive_resume_token</div>
                <pre class="bg-bg-elevated-2 rounded-lg p-3 text-xs font-mono text-info-400 whitespace-pre-wrap break-all border border-border-default">{{ execution.receive_resume_token }}</pre>
            </div>

            <div class="pt-4 border-t border-border-subtle flex flex-wrap items-end gap-4">
                <form method="post" action="/zfs/replication/history/{{ execution.id }}/resume"
                      hx-boost="false" class="flex flex-wrap items-end gap-4">
                    <label class="flex items-center">
                        <input type="checkbox" name="parsable" value="true" class="form-checkbox">
                        <span class="ml-2 text-sm text-text-secondary">Machine-parsable progress (<code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">-P</code>)</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" name="verbose" value="true" class="form-checkbox">
                        <span class="ml-2 text-sm text-text-secondary">Verbose (<code class="text-xs bg-bg-elevated-3 px-1 py-0.5 rounded">-v</code>)</span>
                    </label>
                    <button type="submit" class="btn-primary btn-sm inline-flex items-center gap-2">
                        Resume Transfer
                    </button>
                </form>

                <form method="post" action="/zfs/replication/history/{{ execution.id }}/discard"
                      id="form-discard-resume-{{ execution.id }}" hx-boost="false">
                    <button type="button" class="btn-danger btn-sm inline-flex items-center gap-2"
                            onclick="showConfirm('confirm-discard-resume-{{ execution.id }}')">
                        Discard Saved State
                    </button>
                </form>
            </div>
        </div>
    </div>

    {% set id = 'confirm-discard-resume-' ~ execution.id|string %}
    {% set title = 'Discard Resumable Receive State' %}
    {% set message = 'Run zfs receive -A on ' ~ execution.receive_resume_target ~ '? This destroys the partially received dataset on the receiving side and cannot be undone.' %}
    {% set confirm_text = 'Discard State' %}
    {% set confirm_class = 'danger' %}
    {% set confirm_action = 'document.getElementById("form-discard-resume-' ~ execution.id|string ~ '").submit()' %}
    {% include 'partials/confirm.jinja' %}
    {% endif %}

    <!-- Execution Summary -->
    <div class="card mb-6">
        <div class="px-6 py-4 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary flex items-center">
                <svg class="w-5 h-5 mr-2 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                Execution Summary
            </h2>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Source Dataset</div>
                    <div class="font-mono text-primary-400">{{ execution.source_dataset }}</div>
                </div>
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Target Dataset</div>
                    <div class="font-mono text-success-400">{{ execution.target_dataset }}</div>
                </div>
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Replication Type</div>
                    <div><span class="badge-info">{{ execution.replication_type }}</span></div>
                </div>
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Snapshot</div>
                    <div class="font-mono text-sm">{{ execution.snapshot_name or 'N/A' }}</div>
                </div>
            </div>

            {% if execution.command %}
            <div class="mt-4 pt-4 border-t border-border-subtle">
                <div class="text-sm text-text-tertiary mb-1">Command</div>
                <pre class="bg-bg-elevated-2 rounded-lg p-3 text-sm font-mono text-info-400 whitespace-pre-wrap overflow-x-auto border border-border-default">{{ execution.command }}</pre>
            </div>
            {% endif %}

            {% if execution.receive_options %}
            <div class="mt-4 pt-4 border-t border-border-subtle">
                <div class="text-sm text-text-tertiary mb-1">Receive Options</div>
                <div class="text-sm text-text-secondary space-y-1">
                    <div>
                        <span class="font-mono">-u</span>:
                        {{ 'leave received datasets unmounted' if execution.receive_options.unmounted else 'not set, received datasets are mounted' }}
                    </div>
                    {% if execution.receive_options.target_mode and execution.receive_options.target_mode != 'default' %}
                    <div>
                        <span class="font-mono">-{{ 'd' if execution.receive_options.target_mode == 'discard' else 'e' }}</span>:
                        {{ 'discard first path component' if execution.receive_options.target_mode == 'discard' else 'use only last path component' }}
                    </div>
                    {% endif %}
                    {% for name, value in execution.receive_options.overrides.items() %}
                    <div><span class="font-mono">-o</span> {{ name }}={{ value }}</div>
                    {% endfor %}
                    {% for name in execution.receive_options.excludes %}
                    <div><span class="font-mono">-x</span> {{ name }}</div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-4 pt-4 border-t border-border-subtle">
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Started At</div>
                    <div class="text-sm">{{ execution.started_at }}</div>
                </div>
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Completed At</div>
                    <div class="text-sm">{{ execution.completed_at or 'Running...' }}</div>
                </div>
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Duration</div>
                    <div class="text-sm font-medium">
                        {% if execution.duration_seconds %}
                            {{ "%.2f"|format(execution.duration_seconds) }} seconds
                        {% else %}
                            -
                        {% endif %}
                    </div>
                </div>
                <div>
                    <div class="text-sm text-text-tertiary mb-1">Bytes Transferred</div>
                    <div class="text-sm font-medium">
                        {% if execution.bytes_transferred and execution.bytes_transferred > 0 %}
                            {{ (execution.bytes_transferred / 1024 / 1024)|round(2) }} MB
                        {% else %}
                            -
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Real-time Progress Monitoring (for running executions) -->
    {% if execution.status == 'running' %}
    <div class="card mb-6">
        <div class="px-6 py-4 border-b border-border-subtle flex items-center justify-between">
            <h2 class="text-xl font-semibold text-text-primary">Real-Time Progress</h2>
            <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-success-500 rounded-full animate-pulse"></div>
                <span class="text-sm text-success-400">Live</span>
            </div>
        </div>
        <div class="p-6">
            <div id="live-progress" class="p-4 bg-bg-elevated-2 rounded-lg">
                <p class="text-text-secondary">Connecting to progress stream...</p>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Error Message (if failed) -->
    {% if execution.status == 'failure' and execution.error_message %}
    <div class="card mb-6">
        <div class="px-6 py-4 border-b border-border-subtle bg-danger-900/20 flex items-center justify-between">
            <h2 class="text-xl font-semibold text-danger-400 flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Error Details
            </h2>
            <a href="/zfs/replication/history/{{ execution.id }}/error-log"
               hx-boost="false"
               class="btn-danger btn-sm inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Download Error Log
            </a>
        </div>
        <div class="p-6">
            <pre class="bg-bg-elevated-2 rounded-lg p-4 text-sm font-mono text-danger-400 whitespace-pre-wrap overflow-x-auto border border-danger-900/30">{{ execution.error_message }}</pre>
        </div>
    </div>
    {% endif %}

    <!-- Progress Updates -->
    {% if execution.progress_updates and execution.progress_updates|length > 0 %}
    <div class="card mb-6">
        <div class="px-6 py-4 border-b border-border-subtle flex items-center justify-between">
            <h2 class="text-xl font-semibold text-text-primary">Progress Updates</h2>
            <span class="text-text-tertiary text-sm">{{ execution.progress_updates|length }} updates</span>
        </div>
        <div class="p-6">
            <div class="space-y-3">
                {% for progress in execution.progress_updates %}
                <div class="flex items-start space-x-4 p-3 bg-bg-elevated-2 rounded-lg">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-sm font-medium">{{ progress.timestamp }}</span>
                            <span class="text-sm font-mono text-primary-400">{{ "%.1f"|format(progress.percentage_complete) }}%</span>
                        </div>
                        <div class="grid grid-cols-3 gap-4 text-sm">
                            <div>
                                <span class="text-text-tertiary">Transferred:</span>
                                <span class="font-mono ml-1">{{ (progress.bytes_transferred / 1024 / 1024)|round(2) }} MB</span>
                            </div>
                            <div>
                                <span class="text-text-tertiary">Rate:</span>
                                <span class="font-mono ml-1">{{ progress.transfer_rate }}</span>
                            </div>
                            <div>
                                <span class="text-text-tertiary">ETA:</span>
                                <span class="font-mono ml-1">{{ progress.estimated_time_remaining or 'N/A' }}</span>
                            </div>
                        </div>
                        {% if progress.status_message %}
                        <div class="mt-2 text-sm text-text-secondary">
                            {{ progress.status_message }}
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Log Output -->
    {% if execution.log_output %}
    <div class="card mb-6">
        <div class="px-6 py-4 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary">Log Output</h2>
        </div>
        <div class="p-6">
            <pre class="bg-bg-elevated-2 rounded-lg p-4 text-sm font-mono text-text-secondary whitespace-pre-wrap overflow-x-auto max-h-96 border border-border-default">{{ execution.log_output }}</pre>
        </div>
    </div>
    {% endif %}

    {% if execution.status == 'running' %}
    <script>
        // Poll the progress endpoint every 2 seconds for real-time updates.
        // Polling is used instead of Server-Sent Events because it works
        // reliably across gunicorn workers and HTMX boosted navigation.
        (function() {
            const liveProgressDiv = document.getElementById('live-progress');
            const progressUrl = '/zfs/replication/api/executions/{{ execution.id }}/progress';
            let pollTimer = null;
            let consecutiveErrors = 0;

            function stopPolling() {
                if (pollTimer !== null) {
                    clearInterval(pollTimer);
                    pollTimer = null;
                }
            }

            function renderProgress(data) {
                if (data.status !== 'running') {
                    stopPolling();
                    liveProgressDiv.innerHTML =
                        '<p class="text-text-secondary">Replication finished with status: ' +
                        data.status + '. <a href="" class="text-primary-400 underline">Refresh</a> to see final details.</p>';
                    return;
                }

                if (!data.progress) {
                    liveProgressDiv.innerHTML =
                        '<p class="text-text-secondary">Replication starting, waiting for first progress update...</p>';
                    return;
                }

                const progress = data.progress;
                const percentage = Number(progress.percentage) || 0;
                const bytesTransferred = Number(progress.bytes_transferred) || 0;
                liveProgressDiv.innerHTML =
                    '<div class="space-y-3">' +
                        '<div class="flex items-center justify-between">' +
                            '<span class="text-lg font-medium">' + (data.job_name || '') + '</span>' +
                            '<span class="text-2xl font-mono text-primary-400">' + percentage.toFixed(1) + '%</span>' +
                        '</div>' +
                        '<div class="w-full bg-bg-base rounded-full h-4 overflow-hidden">' +
                            '<div class="bg-primary-500 h-full rounded-full transition-all duration-500" style="width: ' + percentage + '%"></div>' +
                        '</div>' +
                        '<div class="grid grid-cols-3 gap-4 text-sm">' +
                            '<div><span class="text-text-tertiary">Transferred:</span> <span class="font-mono ml-1">' + (bytesTransferred / 1024 / 1024).toFixed(2) + ' MB</span></div>' +
                            '<div><span class="text-text-tertiary">Rate:</span> <span class="font-mono ml-1">' + (progress.transfer_rate || 'N/A') + '</span></div>' +
                            '<div><span class="text-text-tertiary">ETA:</span> <span class="font-mono ml-1">' + (progress.eta || 'N/A') + '</span></div>' +
                        '</div>' +
                    '</div>';
            }

            function poll() {
                fetch(progressUrl, { cache: 'no-store' })
                    .then(function(response) {
                        if (!response.ok) {
                            throw new Error('HTTP ' + response.status);
                        }
                        return response.json();
                    })
                    .then(function(data) {
                        consecutiveErrors = 0;
                        if (!data.success) {
                            throw new Error(data.error || 'Unknown error');
                        }
                        renderProgress(data);
                    })
                    .catch(function(err) {
                        consecutiveErrors += 1;
                        if (consecutiveErrors >= 5) {
                            stopPolling();
                            liveProgressDiv.innerHTML =
                                '<p class="text-danger-400">Lost connection to progress endpoint: ' +
                                err.message + '. Refresh the page to reconnect.</p>';
                        }
                    });
            }

            poll();
            pollTimer = setInterval(poll, 2000);

            window.addEventListener('beforeunload', stopPolling);
            document.body.addEventListener('htmx:beforeSwap', stopPolling);
        })();
    </script>
    {% endif %}
</div>
{% endblock %}
