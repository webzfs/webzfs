{% extends "layout.jinja" %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center text-sm text-text-secondary">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">Pools</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/zfs/datasets" class="hover:text-text-primary transition-colors">Datasets</a>
        {% if pool %}
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="font-mono text-xs text-text-primary">{{ pool }}</span>
        {% endif %}
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-text-primary font-medium">Create</span>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-3xl font-bold text-text-primary">Create ZFS Dataset</h1>
        <p class="text-text-secondary mt-1">
            {% if pool %}
            Create a new dataset in pool <span class="font-mono text-text-primary">{{ pool }}</span>
            {% else %}
            Create a new filesystem or volume dataset
            {% endif %}
        </p>
    </div>

    <!-- Error Message -->
    {% if error %}
        {% with message=error %}
            {% include "partials/error.jinja" %}
        {% endwith %}
    {% endif %}

    <!-- Create Form -->
    <div class="card">
        <div class="card-body">
            <form method="post" action="/zfs/datasets/create" id="create-dataset-form"
                  class="space-y-6" hx-boost="false"
                  onsubmit="return prepareDatasetCreate(event)" x-data="{ 
                datasetType: '{{ dataset_type if dataset_type else 'filesystem' }}', 
                sparse: {{ 'true' if sparse else 'false' }},
                encryption: '{{ encryption if encryption else '' }}',
                 passphrase: '',
                 passphraseConfirm: '',
                 {# tojson does not escape double quotes; forceescape keeps them inside this double-quoted attribute #}
                 keyFormat: {{ (keyformat or 'passphrase')|tojson|forceescape }},
                 keyLocation: {{ (keylocation or 'prompt')|tojson|forceescape }},
                 keyFilePath: {{ (key_file_path or '')|tojson|forceescape }},
                 keyUrl: {{ (key_url or '')|tojson|forceescape }},
                 keySource: {{ (key_source or 'existing')|tojson|forceescape }},
                 keyString: '',
                 get isKeyStringInvalid() {
                     if (this.keySource !== 'string') return false;
                     var bytes = new TextEncoder().encode(this.keyString).length;
                     if (this.keyFormat === 'raw') return bytes !== 32;
                     if (this.keyFormat === 'hex') return !/^[0-9a-fA-F]{64}$/.test(this.keyString.trim());
                     return bytes < 8 || bytes > 512;
                 },
                parentDataset: '{{ parent if parent else (pool if pool else '') }}',
                datasetSuffix: '',
                get fullDatasetName() {
                    if (!this.parentDataset || !this.datasetSuffix) return '';
                    return this.parentDataset + '/' + this.datasetSuffix;
                },
                get isNameIncomplete() {
                    return !this.parentDataset || !this.datasetSuffix || this.datasetSuffix.includes('/');
                 },
                 get isKeyConfigInvalid() {
                     if (this.encryption === '') return false;
                     if (this.keyLocation === 'prompt') {
                         return this.keyFormat !== 'passphrase' ||
                             this.passphrase.length < 8 ||
                             this.passphrase !== this.passphraseConfirm;
                     }
                     if (this.keyLocation === 'file') {
                         return this.keyFilePath.trim() === '' || this.isKeyStringInvalid;
                     }
                     if (this.keyLocation === 'https') {
                         return this.keyUrl.trim() === '';
                     }
                     return true;
                 },
                 get isFormIncomplete() {
                     return this.isNameIncomplete || this.isKeyConfigInvalid;
                }
            }">
                <!-- Hidden field for the full dataset name (submitted to server) -->
                <input type="hidden" name="dataset_name" :value="fullDatasetName">
                
                <!-- Dataset Name - Two Part Input -->
                <div>
                    <label class="form-label">
                        Dataset Name <span class="text-danger-400">*</span>
                    </label>
                    
                    {% if pool and pool_datasets %}
                    <!-- Pool specified with datasets available - show dropdown -->
                    <div class="flex items-center gap-2">
                        <div class="flex-1">
                            <select 
                                x-model="parentDataset"
                                class="form-select"
                            >
                                <option value="">Select parent dataset...</option>
                                {% for ds in pool_datasets %}
                                <option value="{{ ds.name }}" {% if ds.name == pool or ds.name == parent %}selected{% endif %}>{{ ds.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <span class="text-text-tertiary text-lg font-mono">/</span>
                        <div class="flex-1">
                            <input 
                                type="text" 
                                x-model="datasetSuffix"
                                :class="datasetSuffix && datasetSuffix.includes('/') ? 'form-input border-danger-500 ring-1 ring-danger-500' : 'form-input'"
                                placeholder="new_dataset_name"
                            >
                        </div>
                    </div>
                    <p class="text-sm mt-2 text-text-tertiary">
                        <span x-show="!isNameIncomplete" class="text-text-secondary">
                            Full path: <span class="font-mono text-text-primary" x-text="fullDatasetName"></span>
                        </span>
                        <span x-show="isNameIncomplete && !datasetSuffix" class="text-text-tertiary">
                            Select a parent dataset and enter a name for the new dataset
                        </span>
                        <span x-show="datasetSuffix && datasetSuffix.includes('/')" class="text-danger-400">
                            Dataset name cannot contain slashes - use the dropdown to select parent
                        </span>
                    </p>
                    {% elif pool %}
                    <!-- Pool specified but no datasets yet - show pool as prefix with text input -->
                    <div class="flex items-center gap-2">
                        <div class="bg-bg-elevated-2 px-3 py-2 rounded-lg border border-border-subtle">
                            <span class="font-mono text-text-primary">{{ pool }}</span>
                        </div>
                        <span class="text-text-tertiary text-lg font-mono">/</span>
                        <div class="flex-1">
                            <input 
                                type="text" 
                                x-model="datasetSuffix"
                                x-init="parentDataset = '{{ pool }}'"
                                :class="datasetSuffix && datasetSuffix.includes('/') ? 'form-input border-danger-500 ring-1 ring-danger-500' : 'form-input'"
                                placeholder="new_dataset_name"
                            >
                        </div>
                    </div>
                    <p class="text-sm mt-2 text-text-tertiary">
                        <span x-show="!isNameIncomplete" class="text-text-secondary">
                            Full path: <span class="font-mono text-text-primary" x-text="fullDatasetName"></span>
                        </span>
                        <span x-show="isNameIncomplete && !datasetSuffix" class="text-text-tertiary">
                            Enter a name for the new dataset in pool <span class="font-mono">{{ pool }}</span>
                        </span>
                        <span x-show="datasetSuffix && datasetSuffix.includes('/')" class="text-danger-400">
                            Dataset name cannot contain slashes
                        </span>
                    </p>
                    {% else %}
                    <!-- No pool specified - show full text input (legacy behavior) -->
                    <input 
                        type="text" 
                        x-model="parentDataset"
                        x-init="datasetSuffix = 'placeholder'"
                        class="form-input"
                        placeholder="e.g., tank/mydata or tank/storage/documents"
                    >
                    <!-- Override hidden field for legacy mode -->
                    <input type="hidden" name="dataset_name" :value="parentDataset" x-show="false">
                    <p class="text-text-tertiary text-sm mt-1">
                        Full path including pool name (e.g., poolname/dataset/subdataset)
                    </p>
                    <script>
                        // For legacy mode, we need to submit parentDataset directly
                        document.addEventListener('alpine:init', () => {
                            Alpine.data('legacyMode', () => ({
                                init() {
                                    this.$watch('parentDataset', value => {
                                        this.datasetSuffix = value ? 'set' : '';
                                    });
                                }
                            }));
                        });
                    </script>
                    {% endif %}
                </div>

                <!-- Dataset Type -->
                <div>
                    <label for="dataset_type" class="form-label">
                        Dataset Type <span class="text-danger-400">*</span>
                    </label>
                    <select 
                        id="dataset_type" 
                        name="dataset_type"
                        class="form-select"
                        x-model="datasetType"
                    >
                        <option value="filesystem">Filesystem</option>
                        <option value="volume">Volume (zvol)</option>
                    </select>
                    <p class="text-text-tertiary text-sm mt-1">
                        Filesystem for file storage, Volume for block devices
                    </p>
                </div>

                <!-- Volume Size (only for volumes) -->
                <div x-show="datasetType === 'volume'" x-transition>
                    <label for="volsize" class="form-label">
                        Volume Size <span class="text-danger-400">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="volsize" 
                        name="volsize"
                        class="form-input"
                        placeholder="e.g., 10G, 500M, 1T"
                        :required="datasetType === 'volume'"
                    >
                    <p class="text-text-tertiary text-sm mt-1">
                        Specify size with unit: K, M, G, T (e.g., 10G for 10 gigabytes)
                    </p>
                </div>

                <!-- Volume Options (only for volumes) -->
                <div x-show="datasetType === 'volume'" x-transition
                     class="border-t border-border-subtle pt-6 space-y-6">
                    <h3 class="text-lg font-semibold text-text-primary">Volume Options</h3>

                    <div class="flex items-start gap-3">
                        <input
                            type="checkbox"
                            id="sparse"
                            name="sparse"
                            value="on"
                            class="form-checkbox mt-1"
                            x-model="sparse"
                        >
                        <div>
                            <label for="sparse" class="form-label mb-0 cursor-pointer">
                                Sparse volume (thin provisioned)
                            </label>
                            <p class="text-text-tertiary text-sm mt-1">
                                Creates the volume with no reservation
                                (<span class="font-mono">refreservation=none</span>).
                                Only space actually written is consumed, but writes can fail
                                with ENOSPC when the pool is full.
                            </p>
                        </div>
                    </div>

                    <div>
                        <label for="volblocksize" class="form-label">
                            Volume Block Size (volblocksize)
                        </label>
                        <select
                            id="volblocksize"
                            name="volblocksize"
                            class="form-select"
                        >
                            <option value="" {% if not volblocksize %}selected{% endif %}>
                                Default (16K on OpenZFS 2.2 and later, 8K before)
                            </option>
                            {% for size in ['512', '1K', '2K', '4K', '8K', '16K', '32K', '64K', '128K'] %}
                            <option value="{{ size }}" {% if volblocksize == size %}selected{% endif %}>
                                {{ size }}
                            </option>
                            {% endfor %}
                        </select>
                        <p class="text-text-tertiary text-sm mt-1">
                            Power of two between 512B and 128KiB. Cannot be changed once data
                            has been written to the volume.
                        </p>
                    </div>
                </div>

                <!-- Mountpoint (only for filesystems) -->
                <div x-show="datasetType === 'filesystem'" x-transition>
                    <label for="mountpoint" class="form-label">
                        Mountpoint
                    </label>
                    <input 
                        type="text" 
                        id="mountpoint" 
                        name="mountpoint" 
                        value="{{ mountpoint if mountpoint else '' }}"
                        class="form-input"
                        placeholder="Leave empty for automatic (e.g., /poolname/dataset)"
                    >
                    <p class="text-text-tertiary text-sm mt-1">
                        Custom mountpoint path, or leave empty to use default. Use 'none' to disable mounting.
                    </p>
                </div>

                <!-- Compression -->
                <div>
                    <label for="compression" class="form-label">
                        Compression
                    </label>
                    <select 
                        id="compression" 
                        name="compression"
                        class="form-select"
                    >
                        <option value="off" {% if compression == 'off' %}selected{% endif %}>Off</option>
                        <option value="lz4" {% if not compression or compression == 'lz4' %}selected{% endif %}>LZ4 (Recommended)</option>
                        <option value="gzip" {% if compression == 'gzip' %}selected{% endif %}>GZIP</option>
                        <option value="gzip-1" {% if compression == 'gzip-1' %}selected{% endif %}>GZIP-1 (Fastest)</option>
                        <option value="gzip-9" {% if compression == 'gzip-9' %}selected{% endif %}>GZIP-9 (Best)</option>
                        <option value="zstd" {% if compression == 'zstd' %}selected{% endif %}>ZSTD</option>
                        <option value="lzjb" {% if compression == 'lzjb' %}selected{% endif %}>LZJB (Legacy)</option>
                    </select>
                    <p class="text-text-tertiary text-sm mt-1">
                        LZ4 is recommended for best performance/compression balance
                    </p>
                </div>

                <!-- Record Size (filesystems only; zvols use volblocksize) -->
                <div x-show="datasetType === 'filesystem'" x-transition>
                    <label for="recordsize" class="form-label">
                        Record Size
                    </label>
                    <select 
                        id="recordsize" 
                        name="recordsize"
                        class="form-select"
                    >
                        <option value="">Default (128K)</option>
                        <option value="4K" {% if recordsize == '4K' %}selected{% endif %}>4K (Database)</option>
                        <option value="8K" {% if recordsize == '8K' %}selected{% endif %}>8K (Database)</option>
                        <option value="16K" {% if recordsize == '16K' %}selected{% endif %}>16K (Small files)</option>
                        <option value="32K" {% if recordsize == '32K' %}selected{% endif %}>32K</option>
                        <option value="64K" {% if recordsize == '64K' %}selected{% endif %}>64K</option>
                        <option value="128K" {% if recordsize == '128K' %}selected{% endif %}>128K (Default)</option>
                        <option value="256K" {% if recordsize == '256K' %}selected{% endif %}>256K</option>
                        <option value="512K" {% if recordsize == '512K' %}selected{% endif %}>512K (Large files)</option>
                        <option value="1M" {% if recordsize == '1M' %}selected{% endif %}>1M (Large files)</option>
                    </select>
                    <p class="text-text-tertiary text-sm mt-1">
                        Smaller recordsize (4K-16K) for databases, larger (256K-1M) for large sequential files
                    </p>
                </div>

                <!-- ATime -->
                <div>
                    <label for="atime" class="form-label">
                        Access Time Updates (atime)
                    </label>
                    <select 
                        id="atime" 
                        name="atime"
                        class="form-select"
                    >
                        <option value="off" {% if not atime or atime == 'off' %}selected{% endif %}>Off (Recommended)</option>
                        <option value="on" {% if atime == 'on' %}selected{% endif %}>On</option>
                    </select>
                    <p class="text-text-tertiary text-sm mt-1">
                        <strong>Off is recommended:</strong> Disabling atime improves performance by not writing to disk on every file read. 
                        Enable atime only if you need to track when files were last accessed (e.g., for compliance, backup software that relies on access times, or mail servers).
                    </p>
                </div>

                <!-- Creation-Only Filesystem Properties -->
                <div x-show="datasetType === 'filesystem'" x-transition class="space-y-6 border-t border-border-subtle pt-6">
                    <div>
                        <h3 class="text-lg font-semibold text-text-primary mb-1">Creation-Only Properties</h3>
                        <p class="text-text-secondary text-sm">
                            These properties cannot be changed after the dataset is created. Leave at Default to inherit from the parent dataset.
                        </p>
                    </div>

                    <!-- Case Sensitivity -->
                    <div>
                        <label for="casesensitivity" class="form-label">
                            Case Sensitivity
                        </label>
                        <select 
                            id="casesensitivity" 
                            name="casesensitivity"
                            class="form-select"
                        >
                            <option value="">Default (inherit)</option>
                            <option value="sensitive" {% if casesensitivity == 'sensitive' %}selected{% endif %}>sensitive (POSIX standard)</option>
                            <option value="insensitive" {% if casesensitivity == 'insensitive' %}selected{% endif %}>insensitive (Windows/SMB style)</option>
                            <option value="mixed" {% if casesensitivity == 'mixed' %}selected{% endif %}>mixed</option>
                        </select>
                        <p class="text-text-tertiary text-sm mt-1">
                            Controls whether file names are case sensitive. Use insensitive or mixed for SMB shares accessed by Windows clients.
                        </p>
                    </div>

                    <!-- Normalization -->
                    <div>
                        <label for="normalization" class="form-label">
                            Unicode Normalization
                        </label>
                        <select 
                            id="normalization" 
                            name="normalization"
                            class="form-select"
                        >
                            <option value="">Default (inherit)</option>
                            <option value="none" {% if normalization == 'none' %}selected{% endif %}>none - no normalization, names compared byte for byte</option>
                            <option value="formC" {% if normalization == 'formC' %}selected{% endif %}>formC - composed (e with accent stored as one character)</option>
                            <option value="formD" {% if normalization == 'formD' %}selected{% endif %}>formD - decomposed (e plus accent stored separately, matches macOS)</option>
                            <option value="formKC" {% if normalization == 'formKC' %}selected{% endif %}>formKC - composed, also treats lookalike characters as equal</option>
                            <option value="formKD" {% if normalization == 'formKD' %}selected{% endif %}>formKD - decomposed, also treats lookalike characters as equal</option>
                        </select>
                        <p class="text-text-tertiary text-sm mt-1">
                            Some accented characters can be written in Unicode in more than one way. Normalization makes ZFS treat these different spellings as the same file name. Choose formD for datasets shared with macOS clients, formC for general cross-platform use, or none if all clients are Linux/BSD. Selecting any form other than none implies UTF-8 only file names.
                        </p>
                    </div>

                    <!-- UTF-8 Only -->
                    <div>
                        <label for="utf8only" class="form-label">
                            UTF-8 Only File Names
                        </label>
                        <select 
                            id="utf8only" 
                            name="utf8only"
                            class="form-select"
                        >
                            <option value="">Default (inherit)</option>
                            <option value="on" {% if utf8only == 'on' %}selected{% endif %}>on</option>
                            <option value="off" {% if utf8only == 'off' %}selected{% endif %}>off</option>
                        </select>
                        <p class="text-text-tertiary text-sm mt-1">
                            Reject file names that are not valid UTF-8. Cannot be off when a normalization form other than none is selected.
                        </p>
                    </div>
                </div>

                <!-- Encryption -->
                <div>
                    <label for="encryption" class="form-label">
                        Encryption
                        {% if not supports_encryption %}
                        <span class="text-text-tertiary text-xs ml-2">(Not supported on this platform)</span>
                        {% endif %}
                    </label>
                    <select 
                        id="encryption" 
                        name="encryption"
                        class="form-select {% if not supports_encryption %}opacity-50 cursor-not-allowed{% endif %}"
                        x-model="encryption"
                        {% if not supports_encryption %}disabled{% endif %}
                    >
                        <option value="">Off (No Encryption)</option>
                        {% if supports_encryption %}
                        <option value="aes-256-gcm">AES-256-GCM (Recommended)</option>
                        <option value="aes-128-gcm">AES-128-GCM</option>
                        <option value="aes-192-gcm">AES-192-GCM</option>
                        <option value="aes-256-ccm">AES-256-CCM</option>
                        <option value="aes-128-ccm">AES-128-CCM</option>
                        <option value="aes-192-ccm">AES-192-CCM</option>
                        {% endif %}
                    </select>
                    {% if supports_encryption %}
                    <p class="text-text-tertiary text-sm mt-1">
                        Enable native ZFS encryption. AES-256-GCM provides the best security and performance.
                    </p>
                    {% else %}
                    <p class="text-warning-400 text-sm mt-1">
                        ZFS encryption is not supported on NetBSD. Datasets will be created without encryption.
                    </p>
                    {% endif %}
                </div>

                <!-- Encryption key options (only when encryption is enabled) -->
                <div x-show="encryption !== ''" x-transition class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="keyformat" class="form-label">
                                Key Format <span class="text-danger-400">*</span>
                            </label>
                            <select
                                id="keyformat"
                                name="keyformat"
                                class="form-select"
                                x-model="keyFormat"
                                :disabled="encryption === ''"
                            >
                                <option value="passphrase">Passphrase</option>
                                <option value="hex">Hex key</option>
                                <option value="raw">Raw key (32 bytes)</option>
                            </select>
                            <p class="text-text-tertiary text-sm mt-1">
                                Passphrases may be entered in the form. Hex and raw keys are read by ZFS from the key location, never by WebZFS.
                            </p>
                        </div>

                        <div>
                            <label for="keylocation" class="form-label">
                                Key Location <span class="text-danger-400">*</span>
                            </label>
                            <select
                                id="keylocation"
                                name="keylocation"
                                class="form-select"
                                x-model="keyLocation"
                                :disabled="encryption === ''"
                            >
                                <option value="prompt">Prompt (enter a passphrase)</option>
                                <option value="file">File (file:///absolute/path)</option>
                                {% if https_keylocation_supported %}
                                <option value="https">HTTPS URL</option>
                                {% endif %}
                            </select>
                            {% if https_keylocation_supported %}
                            <p class="text-text-tertiary text-sm mt-1">
                                https:// key locations use the libfetch/libcurl back-end compiled into OpenZFS.
                            </p>
                            {% else %}
                            <p class="text-warning-400 text-sm mt-1">
                                https:// key locations are unavailable: this OpenZFS build has no libfetch/libcurl back-end.
                            </p>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Passphrase fields (prompt location) -->
                    <div x-show="keyLocation === 'prompt'" class="space-y-4">
                        <div>
                            <label for="passphrase" class="form-label">
                                Encryption Passphrase <span class="text-danger-400">*</span>
                            </label>
                            <input
                                type="password"
                                id="passphrase"
                                name="passphrase"
                                class="form-input"
                                placeholder="Enter a strong passphrase"
                                x-model="passphrase"
                                minlength="8"
                                :required="encryption !== '' && keyLocation === 'prompt'"
                                :disabled="encryption === '' || keyLocation !== 'prompt'"
                            >
                            <p class="text-text-tertiary text-sm mt-1">
                                Use at least 8 characters. This passphrase will be required to unlock the dataset after system reboot.
                            </p>
                            <p x-show="encryption !== '' && keyLocation === 'prompt' && passphrase.length > 0 && passphrase.length < 8"
                               class="text-danger-400 text-sm mt-1">
                                Passphrase must be at least 8 characters long.
                            </p>
                        </div>

                        <div>
                            <label for="passphrase_confirm" class="form-label">
                                Confirm Passphrase <span class="text-danger-400">*</span>
                            </label>
                            <input
                                type="password"
                                id="passphrase_confirm"
                                name="passphrase_confirm"
                                class="form-input"
                                placeholder="Re-enter passphrase"
                                x-model="passphraseConfirm"
                                minlength="8"
                                :required="encryption !== '' && keyLocation === 'prompt'"
                                :disabled="encryption === '' || keyLocation !== 'prompt'"
                            >
                            <p x-show="encryption !== '' && keyLocation === 'prompt' && passphraseConfirm.length > 0 && passphrase !== passphraseConfirm"
                               class="text-danger-400 text-sm mt-1">
                                Passphrases do not match.
                            </p>
                        </div>
                    </div>

                    <p x-show="encryption !== '' && keyLocation === 'prompt' && keyFormat !== 'passphrase'"
                       class="text-danger-400 text-sm">
                        Hex and raw keys cannot be typed at a prompt. Choose a file or https key location.
                    </p>

                    <!-- File key source -->
                    <div x-show="keyLocation === 'file'" class="space-y-2">
                        <label for="key_source" class="form-label">
                            Key File Source <span class="text-danger-400">*</span>
                        </label>
                        <select
                            id="key_source"
                            name="key_source"
                            class="form-select"
                            x-model="keySource"
                            :disabled="encryption === '' || keyLocation !== 'file'"
                        >
                            <option value="existing">Use an existing key file</option>
                            <option value="generate">Generate a new random key file</option>
                            <option value="string">Create a key file from text I enter</option>
                        </select>
                        <p class="text-text-tertiary text-sm mt-1" x-show="keySource === 'generate'">
                            WebZFS writes a new random key in the selected format (32 random bytes for raw, 64 hex digits for hex, a random passphrase for passphrase). The key is never shown or logged.
                        </p>
                    </div>

                    <!-- Key text (create key file from text) -->
                    <div x-show="keyLocation === 'file' && keySource === 'string'" class="space-y-2">
                        <label for="key_string" class="form-label">
                            Key Text <span class="text-danger-400">*</span>
                        </label>
                        <input
                            type="password"
                            id="key_string"
                            name="key_string"
                            class="form-input font-mono"
                            autocomplete="off"
                            x-model="keyString"
                            :required="encryption !== '' && keyLocation === 'file' && keySource === 'string'"
                            :disabled="encryption === '' || keyLocation !== 'file' || keySource !== 'string'"
                        >
                        <p class="text-text-tertiary text-sm mt-1">
                            Raw: exactly 32 bytes. Hex: exactly 64 hexadecimal characters. Passphrase: 8 to 512 bytes. The text is written to the key file and is never shown or logged.
                        </p>
                        <p x-show="keyString.length > 0 && isKeyStringInvalid" class="text-danger-400 text-sm mt-1">
                            The key text does not match the size required by the selected key format.
                        </p>
                    </div>

                    <!-- File key path -->
                    <div x-show="keyLocation === 'file'" class="space-y-2">
                        <label for="key_file_path" class="form-label">
                            Key File Path <span class="text-danger-400">*</span>
                        </label>
                        <input
                            type="text"
                            id="key_file_path"
                            name="key_file_path"
                            class="form-input font-mono"
                            placeholder="/etc/zfs/keys/my-dataset.key"
                            x-model="keyFilePath"
                            :required="encryption !== '' && keyLocation === 'file'"
                            :disabled="encryption === '' || keyLocation !== 'file'"
                        >
                        <p class="text-text-tertiary text-sm mt-1" x-show="keySource === 'existing'">
                            Absolute path to an existing key file. It must be a regular file owned by root with mode 0600. WebZFS verifies the permissions without reading the key.
                        </p>
                        <p class="text-text-tertiary text-sm mt-1" x-show="keySource !== 'existing'">
                            Absolute path for the new key file. The file must not exist; WebZFS never overwrites a key file. The directory must be owned by root with no group or other access (mode 0700) and is created with mode 0700 if missing. The file is created owned by root with mode 0600.
                        </p>
                    </div>

                    <!-- Offsite backup warning for key files -->
                    <div x-show="keyLocation === 'file'" class="card-nested bg-warning-900/20 border-warning-700">
                        <h4 class="text-sm font-semibold text-warning-400 mb-1">Back up the key file offsite</h4>
                        <p class="text-sm text-text-secondary">
                            The key file is the only way to unlock this dataset. If it is lost or the disk holding it fails, the encrypted data cannot be recovered. Copy the key file to secure offsite storage as soon as it exists, and keep it off the pool it unlocks.
                        </p>
                    </div>

                    <!-- HTTPS key URL -->
                    <div x-show="keyLocation === 'https'" class="space-y-2">
                        <label for="key_url" class="form-label">
                            Key URL <span class="text-danger-400">*</span>
                        </label>
                        <input
                            type="url"
                            id="key_url"
                            name="key_url"
                            class="form-input font-mono"
                            placeholder="https://keys.example.com/my-dataset.key"
                            x-model="keyUrl"
                            :required="encryption !== '' && keyLocation === 'https'"
                            :disabled="encryption === '' || keyLocation !== 'https'"
                        >
                        <p class="text-text-tertiary text-sm mt-1">
                            ZFS fetches the key from this URL itself. ZFS must be built with the libfetch or libcurl back-end; SSL_CA_CERT_FILE / SSL_CA_CERT_PATH can be set in the service environment for private CAs.
                        </p>
                    </div>

                    <!-- Info box about key handling -->
                    <div class="card-nested bg-info-900/20 border-info-700">
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-info-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                            <div>
                                <h4 class="text-sm font-semibold text-info-400 mb-1">Key handling</h4>
                                <p class="text-sm text-text-secondary">
                                    File and https keys are loaded by ZFS without a prompt, so the dataset can be unlocked again after <code class="bg-bg-tertiary px-1 py-0.5 rounded text-xs">zfs unload-key</code> without entering a passphrase. Passphrases and key material are never written to WebZFS logs; the key file path is recorded in the audit log. Raw and hex keys cannot be entered interactively and must use a file or https location.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Options Section -->
                <div class="border-t border-border-subtle pt-6">
                    <h3 class="text-lg font-semibold text-text-primary mb-2">Additional Options</h3>
                    <p class="text-text-secondary text-sm">
                        More properties can be configured after creation via the properties page.
                    </p>
                </div>

                <!-- Warning Box -->
                <div class="card-nested bg-warning-900/20 border-warning-700">
                    <div class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-warning-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                            <h3 class="text-sm font-semibold text-warning-400 mb-2">Important Notes:</h3>
                            <ul class="list-disc list-inside space-y-1 text-sm text-text-secondary">
                                <li>Dataset names must be unique within the pool</li>
                                <li>Parent datasets must exist (or will be created automatically)</li>
                                <li>Volumes (zvols) require a size specification</li>
                                <li>Most properties can be changed after creation, except case sensitivity, normalization, and UTF-8 only which are fixed at creation time</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end gap-3 pt-4">
                    <a href="/zfs/datasets" class="btn-secondary">
                        Cancel
                    </a>
                    <button 
                        type="submit" 
                        id="create-dataset-button"
                        class="inline-flex items-center gap-2 htmx-loading font-medium py-2 px-4 rounded-lg transition-colors"
                        :class="isFormIncomplete ? 'bg-gray-600 text-gray-400 cursor-not-allowed' : 'btn-success'"
                        :disabled="isFormIncomplete"
                    >
                        <span class="htmx-indicator">
                            <div class="loading-spinner loading-spinner-sm"></div>
                        </span>
                        <span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                        </span>
                        <span>Create Dataset</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Dataset Creation In-Progress Overlay -->
<div
    id="dataset-create-progress-overlay"
    class="modal-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="dataset-create-progress-title"
    aria-describedby="dataset-create-progress-message"
    style="display: none;"
>
    <div class="fixed inset-0 bg-black/80 backdrop-blur-sm"></div>
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="modal modal-sm text-center">
                <div class="flex items-center justify-center mb-4">
                    <div class="loading-spinner loading-spinner-lg" aria-hidden="true"></div>
                </div>
                <h3 id="dataset-create-progress-title" class="text-xl font-semibold text-text-primary mb-2">
                    Creating Dataset
                </h3>
                <p id="dataset-create-progress-message" class="text-text-secondary">
                    Creating dataset <strong id="dataset-create-progress-name" class="font-mono text-text-primary"></strong>.
                    This operation may take a while. Please wait and do not close or refresh this page.
                </p>
            </div>
        </div>
    </div>
</div>

<script>
var datasetCreateSubmitting = false;

function prepareDatasetCreate(event) {
    const form = event.currentTarget;
    if (!form || datasetCreateSubmitting) {
        return false;
    }

    if (!form.checkValidity()) {
        form.reportValidity();
        return false;
    }

    const passphrase = document.getElementById('passphrase');
    const passphraseConfirm = document.getElementById('passphrase_confirm');
    const encryption = document.getElementById('encryption');
    const keyLocation = document.getElementById('keylocation');
    if (encryption && encryption.value && keyLocation && keyLocation.value === 'prompt') {
        if (!passphrase || passphrase.value.length < 8) {
            passphrase.setCustomValidity('Passphrase must be at least 8 characters long.');
            passphrase.reportValidity();
            return false;
        }
        passphrase.setCustomValidity('');

        if (!passphraseConfirm || passphrase.value !== passphraseConfirm.value) {
            passphraseConfirm.setCustomValidity('Passphrases do not match.');
            passphraseConfirm.reportValidity();
            return false;
        }
        passphraseConfirm.setCustomValidity('');
    }

    datasetCreateSubmitting = true;
    const overlay = document.getElementById('dataset-create-progress-overlay');
    const datasetNameFields = form.querySelectorAll('input[name="dataset_name"]');
    const datasetName = datasetNameFields[datasetNameFields.length - 1];
    const datasetNameElement = document.getElementById('dataset-create-progress-name');
    const createButton = document.getElementById('create-dataset-button');

    if (datasetNameElement && datasetName) {
        datasetNameElement.textContent = datasetName.value;
    }
    if (createButton) {
        createButton.disabled = true;
        createButton.classList.add('opacity-50', 'cursor-not-allowed');
    }
    if (overlay) {
        overlay.style.display = 'block';
        overlay.setAttribute('aria-busy', 'true');
    }

    return true;
}

document.addEventListener('input', function(event) {
    if (event.target && (event.target.id === 'passphrase' || event.target.id === 'passphrase_confirm')) {
        event.target.setCustomValidity('');
    }
});
</script>
{% endblock %}
