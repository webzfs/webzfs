{% extends "layout_main.jinja" %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="container-page max-w-6xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
            <li class="flex items-center">
                <a href="/" class="text-primary-400 hover:text-primary-300 transition-colors">Home</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li class="flex items-center">
                <a href="/zfs/observability" class="text-primary-400 hover:text-primary-300 transition-colors">Observability</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li>
                <span class="text-text-primary font-medium">Latency Histograms</span>
            </li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-text-primary mb-2">I/O Latency Histograms</h1>
            <p class="text-text-secondary">Per-bucket I/O latency distribution from <code class="font-mono">zpool iostat -w</code></p>
        </div>
        {% if pools %}
        <form method="get" action="/zfs/observability/latency-histogram" class="flex items-center gap-2">
            <label for="pool-select" class="text-sm text-text-secondary">Pool</label>
            <select id="pool-select" name="pool" class="form-select" onchange="this.form.submit()">
                {% for name in pools %}
                <option value="{{ name }}" {% if name == selected_pool %}selected{% endif %}>{{ name }}</option>
                {% endfor %}
            </select>
            <noscript><button type="submit" class="btn-secondary">Show</button></noscript>
        </form>
        {% endif %}
    </div>

    <div x-data="latencyHistogram()" data-pool="{{ selected_pool or '' }}">
        <!-- Controls -->
        <div class="card mb-6">
            <div class="card-body flex flex-wrap items-center gap-3">
                <button type="button" class="btn-secondary" @click="showCumulative()" :disabled="busy">
                    Since import
                </button>
                <span class="text-text-tertiary">|</span>
                <label for="sample-seconds" class="text-sm text-text-secondary">Sample window</label>
                <select id="sample-seconds" class="form-select" x-model.number="seconds">
                    {% for choice in sample_choices %}
                    <option value="{{ choice }}">{{ choice }} seconds</option>
                    {% endfor %}
                </select>
                <button type="button" class="btn-primary" @click="load(seconds)" :disabled="busy">
                    Take sample
                </button>
                <button type="button" class="px-4 py-2 transition-colors"
                        :class="autoRefresh ? 'btn-success' : 'btn-secondary'"
                        @click="toggleAutoRefresh()">
                    <span x-text="autoRefresh ? 'Auto refresh: ON' : 'Auto refresh: OFF'"></span>
                </button>
                <span class="text-sm text-text-tertiary" x-show="busy" x-text="status"></span>
            </div>
        </div>

        <div id="histogram-panel">
            <p class="text-text-tertiary">Loading latency histogram...</p>
        </div>
    </div>
</div>

<script>
    // Latency histogram page controller.
    // "Since import" loads cumulative counts. "Take sample" blocks on the
    // server for the selected window and shows only I/Os completed in it.
    // Auto refresh repeats samples back to back until it is turned off.
    function latencyHistogram() {
        return {
            pool: '',
            seconds: 10,
            autoRefresh: false,
            busy: false,
            status: '',
            nextTimer: null,

            init() {
                this.pool = this.$el.dataset.pool;
                this.load(0);
            },

            showCumulative() {
                this.autoRefresh = false;
                this.load(0);
            },

            toggleAutoRefresh() {
                this.autoRefresh = !this.autoRefresh;
                if (this.autoRefresh && !this.busy) {
                    this.load(this.seconds);
                }
                if (!this.autoRefresh && this.nextTimer) {
                    clearTimeout(this.nextTimer);
                    this.nextTimer = null;
                }
            },

            load(sample) {
                if (this.busy) {
                    return;
                }
                this.busy = true;
                this.status = sample ? `Sampling for ${sample} seconds...` : 'Loading...';
                const params = new URLSearchParams({ pool: this.pool, sample: sample });
                htmx.ajax('GET', '/zfs/observability/latency-histogram-table?' + params.toString(),
                          { target: '#histogram-panel', swap: 'innerHTML' })
                    .then(() => this.finish(true), () => this.finish(false));
            },

            finish(ok) {
                this.busy = false;
                this.status = '';
                const failed = !ok || document.querySelector('#histogram-panel [data-histogram-error]');
                if (failed) {
                    this.autoRefresh = false;
                    return;
                }
                if (this.autoRefresh) {
                    // Short pause so a fast failure cannot loop without delay.
                    this.nextTimer = setTimeout(() => {
                        this.nextTimer = null;
                        if (this.autoRefresh) {
                            this.load(this.seconds);
                        }
                    }, 1000);
                }
            },
        };
    }
</script>
{% endblock %}
