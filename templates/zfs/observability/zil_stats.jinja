{% extends "layout_main.jinja" %}

{% block title %}{{ page_title }}{% endblock %}

{% block content %}
<div class="container-page max-w-6xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
            <li class="flex items-center">
                <a href="/" class="text-primary-400 hover:text-primary-300 transition-colors">Home</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li class="flex items-center">
                <a href="/zfs/observability" class="text-primary-400 hover:text-primary-300 transition-colors">Observability</a>
                <svg class="w-4 h-4 mx-2 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li>
                <span class="text-text-primary font-medium">ZIL Statistics</span>
            </li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-text-primary mb-2">ZIL Statistics</h1>
            <p class="text-text-secondary">ZFS Intent Log commit and transaction statistics from the kernel</p>
        </div>
    </div>

    <!-- Error Message -->
    {% if error %}
    <div class="bg-danger-900/30 border-l-4 border-danger-500 text-danger-400 px-4 py-3 rounded mb-6" role="alert">
        <div class="flex items-start">
            <svg class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div><strong class="font-semibold">Error:</strong> {{ error }}</div>
        </div>
    </div>
    {% endif %}

    {% if not zil.available %}
    <!-- Panel hidden when the kstat is not published on this platform -->
    <div class="bg-warning-900/30 border-l-4 border-warning-500 text-warning-400 px-4 py-3 rounded mb-6" role="alert">
        <div class="flex items-start">
            <svg class="w-5 h-5 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div>
                <strong class="font-semibold">ZIL statistics unavailable:</strong>
                {{ zil.error or 'the zil kstat is not published on this system' }}
                {% if zil.platform %}<span class="text-text-tertiary">(platform: {{ zil.platform }})</span>{% endif %}
            </div>
        </div>
    </div>
    {% else %}

    <p class="text-sm text-text-tertiary mb-6">
        Source: <code class="font-mono">{{ zil.source }}</code> &middot; platform: {{ zil.platform }}
    </p>

    <!-- Commit summary -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="card">
            <div class="card-body">
                <p class="text-sm font-medium text-text-secondary">Commit Count</p>
                <p class="text-2xl font-semibold text-text-primary">{{ '{:,}'.format(zil.summary.commit_count) }}</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <p class="text-sm font-medium text-text-secondary">Writer Commits</p>
                <p class="text-2xl font-semibold text-text-primary">{{ '{:,}'.format(zil.summary.commit_writer_count) }}</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <p class="text-sm font-medium text-text-secondary">Commit Errors</p>
                <p class="text-2xl font-semibold {% if zil.summary.commit_error_count %}text-danger-400{% else %}text-text-primary{% endif %}">
                    {{ '{:,}'.format(zil.summary.commit_error_count) }}
                </p>
                <p class="text-xs text-text-tertiary">{{ '%.4f'|format(zil.summary.commit_error_rate) }}% error rate</p>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <p class="text-sm font-medium text-text-secondary">ITX Count</p>
                <p class="text-2xl font-semibold text-text-primary">{{ '{:,}'.format(zil.summary.itx_count) }}</p>
            </div>
        </div>
    </div>

    <!-- Commit health -->
    <div class="card mb-8">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-text-primary mb-4">Commit Health</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="border-b border-border-subtle">
                            <th class="text-left py-2 px-3 text-text-tertiary font-medium text-xs">Metric</th>
                            <th class="text-right py-2 px-3 text-text-tertiary font-medium text-xs">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 text-text-secondary">Stalls</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.commit_stall_count) }}</td>
                        </tr>
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 text-text-secondary">Suspends</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.commit_suspend_count) }}</td>
                        </tr>
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 text-text-secondary">Crash commits</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.commit_crash_count) }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ITX breakdown -->
    <div class="card mb-8">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-text-primary mb-4">Intent Log Records (ITX)</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="border-b border-border-subtle">
                            <th class="text-left py-2 px-3 text-text-tertiary font-medium text-xs">Type</th>
                            <th class="text-right py-2 px-3 text-text-tertiary font-medium text-xs">Records</th>
                            <th class="text-right py-2 px-3 text-text-tertiary font-medium text-xs">Bytes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 text-text-secondary">Indirect</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_indirect_count) }}</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_indirect_bytes) }}</td>
                        </tr>
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 text-text-secondary">Copied</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_copied_count) }}</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_copied_bytes) }}</td>
                        </tr>
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 text-text-secondary">Need copy</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_needcopy_count) }}</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_needcopy_bytes) }}</td>
                        </tr>
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 text-text-secondary">Metaslab (normal)</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_metaslab_normal_count) }}</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_metaslab_normal_bytes) }}</td>
                        </tr>
                        <tr>
                            <td class="py-2 px-3 text-text-secondary">Metaslab (SLOG)</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_metaslab_slog_count) }}</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ '{:,}'.format(zil.summary.itx_metaslab_slog_bytes) }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Raw kstat values -->
    <div class="card">
        <div class="card-body">
            <h2 class="text-xl font-semibold text-text-primary mb-4">Raw kstat Values</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="border-b border-border-subtle">
                            <th class="text-left py-2 px-3 text-text-tertiary font-medium text-xs">Statistic</th>
                            <th class="text-right py-2 px-3 text-text-tertiary font-medium text-xs">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for name, value in zil.stats.items() %}
                        <tr class="border-b border-border-subtle">
                            <td class="py-2 px-3 font-mono text-text-secondary">{{ name }}</td>
                            <td class="py-2 px-3 text-right font-mono text-text-primary">{{ value }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
