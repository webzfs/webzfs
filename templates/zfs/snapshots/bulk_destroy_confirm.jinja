{% extends "layout.jinja" %}

{% block content %}
<div class="max-w-5xl mx-auto space-y-6" x-data="{ open: false }">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center text-sm text-text-secondary">
        <a href="/zfs/pools" class="hover:text-text-primary transition-colors">Pools</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/zfs/snapshots" class="hover:text-text-primary transition-colors">Snapshots</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-text-primary font-medium">Bulk Destroy</span>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-3xl font-bold text-danger-400 inline-flex items-center gap-3">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            Destroy {{ dry_run.snapshot_count or snapshots|length }} Snapshots
        </h1>
        <p class="text-danger-300 mt-2 font-semibold">This action cannot be undone!</p>
    </div>

    <!-- Error Message -->
    {% if error %}
        {% with message=error %}
            {% include "partials/error.jinja" %}
        {% endwith %}
    {% endif %}

    <!-- Warning Box -->
    <div class="card-nested bg-danger-900/30 border-danger-600 border-2">
        <h3 class="text-lg font-bold mb-3 text-danger-300 inline-flex items-center gap-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            DESTRUCTIVE OPERATION WARNING
        </h3>
        <p class="text-danger-200 mb-3">
            You are about to <strong>permanently destroy</strong>
            {{ dry_run.snapshot_count or snapshots|length }} selected snapshot(s)
            in {{ dry_run.commands|length }} grouped <code class="font-mono">zfs destroy</code> command(s).
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="bg-danger-950 border border-danger-700 rounded-lg p-4">
                <div class="text-xs uppercase tracking-wider text-danger-300">Total reclaimable (dry run)</div>
                <div class="text-2xl font-bold text-danger-200 font-mono mt-1">{{ dry_run.total_reclaim_human }}</div>
                <div class="text-xs text-danger-400 font-mono mt-1">{{ dry_run.total_reclaim }} bytes</div>
            </div>
            <div class="bg-bg-elevated-2 border border-border-subtle rounded-lg p-4">
                <div class="text-xs uppercase tracking-wider text-text-secondary">Snapshots / commands</div>
                <div class="text-2xl font-bold text-text-primary font-mono mt-1">
                    {{ dry_run.snapshot_count or snapshots|length }} / {{ dry_run.commands|length }}
                </div>
                <div class="text-xs text-text-tertiary mt-1">Grouped per dataset to avoid one txg sync per snapshot</div>
            </div>
        </div>
    </div>

    <!-- Dry-run errors -->
    {% if dry_run.errors %}
    <div class="card border-danger-600">
        <div class="p-4 bg-danger-900/20 border-b border-danger-700">
            <h2 class="text-lg font-semibold text-danger-300">Dry-run reported problems</h2>
        </div>
        <div class="p-4">
            <ul class="space-y-2 text-sm font-mono text-danger-200 break-all">
                {% for dry_run_error in dry_run.errors %}
                <li>{{ dry_run_error }}</li>
                {% endfor %}
            </ul>
            <p class="text-xs text-text-tertiary mt-3">
                Commands that failed the dry run are still listed below. Each command is atomic: if any snapshot in
                it cannot be destroyed, none of that command's snapshots are destroyed. If the failure is caused by
                clones, enable Defer below and re-run the dry run.
            </p>
        </div>
    </div>
    {% endif %}

    <!-- Grouped commands -->
    <div class="card">
        <div class="p-4 bg-bg-elevated-2 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary inline-flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                </svg>
                Commands (one per dataset / chunk)
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-bg-elevated-2">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Dataset</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Snapshots</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">Command argument</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">Reclaim</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle">
                    {% for command in dry_run.commands %}
                    <tr class="hover:bg-bg-elevated-2 transition-colors">
                        <td class="px-4 py-3 text-sm text-text-primary">{{ command.dataset }}</td>
                        <td class="px-4 py-3 text-sm text-text-secondary font-mono">{{ command.snapshots|length }}</td>
                        <td class="px-4 py-3 text-xs text-text-secondary font-mono break-all">{{ command.spec }}</td>
                        <td class="px-4 py-3 text-sm text-right font-mono {% if command.error %}text-danger-300{% else %}text-text-primary{% endif %}">
                            {% if command.error %}
                                failed
                            {% else %}
                                {{ command.reclaim_human }}
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="p-4 border-t border-border-subtle text-xs text-text-tertiary">
            Dry run executed as <code class="font-mono">zfs destroy -nvp{% if defer %} -d{% endif %} &lt;dataset&gt;@&lt;short&gt;[,&lt;short&gt;...]</code>.
            Nothing was deleted. The reclaim total is what OpenZFS reported for these lists.
        </div>
    </div>

    <!-- Selected snapshots -->
    <div class="card">
        <div class="p-4 bg-bg-elevated-2 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary">Selected snapshots ({{ snapshots|length }})</h2>
        </div>
        <div class="p-4">
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-1 text-xs font-mono text-text-secondary max-h-72 overflow-y-auto">
                {% for snapshot_name in snapshots %}
                <li class="break-all">{{ snapshot_name }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <!-- Confirmation Form (only when the dry run produced a plan) -->
    {% if dry_run.commands %}
    <div class="card">
        <div class="p-4 bg-bg-elevated-2 border-b border-border-subtle">
            <h2 class="text-xl font-semibold text-text-primary inline-flex items-center gap-2">
                <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Confirmation Required
            </h2>
        </div>
        <form id="bulk-destroy-form" method="post" action="/zfs/snapshots/bulk/destroy" class="p-6 space-y-5">
            {% for snapshot_name in snapshots %}
            <input type="hidden" name="snapshots" value="{{ snapshot_name }}">
            {% endfor %}

            <div class="flex items-start gap-3">
                <input type="checkbox" id="bulk-defer" name="defer" value="true"
                       class="form-checkbox h-4 w-4 mt-0.5 text-warning-500 rounded border-border-strong"
                       {% if defer %}checked{% endif %}>
                <div>
                    <label for="bulk-defer" class="text-sm font-medium text-text-primary">Defer destruction (-d)</label>
                    <p class="text-xs text-text-tertiary mt-1">
                        Defer the actual deletion of snapshots that still have clones; they are destroyed once the
                        clones are gone. Without it, destroying a snapshot with clones fails.
                    </p>
                </div>
            </div>

            <div>
                <label for="bulk-confirm" class="form-label">
                    Type <code class="font-mono text-danger-300">{{ confirm_phrase }}</code> to confirm
                </label>
                <input type="text" id="bulk-confirm" name="confirm" autocomplete="off" spellcheck="false"
                       class="form-input w-full font-mono" placeholder="{{ confirm_phrase }}">
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-2">
                <button type="button" x-on:click="open = true"
                        class="btn-danger inline-flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Destroy {{ dry_run.snapshot_count or snapshots|length }} Snapshots
                </button>
                <button type="submit" formaction="/zfs/snapshots/bulk/destroy/confirm"
                        class="btn-secondary inline-flex items-center justify-center gap-2"
                        title="Run the dry run again with the current Defer setting">
                    Re-run Dry Run
                </button>
                <a href="/zfs/snapshots" class="btn-secondary inline-flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    Cancel (Recommended)
                </a>
            </div>
        </form>
    </div>
    {% else %}
    <div class="card-nested">
        <p class="text-sm text-text-secondary mb-4">
            No destroy commands could be planned for this selection, so nothing can be destroyed from this page.
        </p>
        <a href="/zfs/snapshots" class="btn-secondary inline-flex items-center gap-2">Back to Snapshots</a>
    </div>
    {% endif %}

    <!-- Final confirmation modal -->
    <div class="modal-overlay" x-show="open" x-on:keydown.escape.window="open = false"
         style="display: none;"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0">
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm"></div>
        <div class="fixed inset-0 z-50 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div class="modal modal-sm">
                    <div class="flex items-center justify-center w-12 h-12 mx-auto mb-4 rounded-full bg-danger-900/50 border-2 border-danger-500">
                        <svg class="w-6 h-6 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-text-primary text-center mb-2">Final Confirmation Required</h3>
                    <div class="text-text-secondary text-center mb-6">
                        Are you ABSOLUTELY CERTAIN you want to destroy
                        <strong>{{ dry_run.snapshot_count or snapshots|length }}</strong> snapshots in
                        <strong>{{ dry_run.commands|length }}</strong> command(s)?
                        About <strong>{{ dry_run.total_reclaim_human }}</strong> should be reclaimed.
                        This action is IRREVERSIBLE and cannot be undone.
                    </div>
                    <div class="flex space-x-3">
                        <button type="button" class="btn-secondary flex-1" x-on:click="open = false">Cancel</button>
                        <button type="submit" form="bulk-destroy-form"
                                class="btn-danger flex-1 inline-flex items-center justify-center gap-2">
                            Yes, Destroy Forever
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
