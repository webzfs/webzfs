{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-3">
                <a href="/utils" class="text-text-secondary hover:text-text-primary transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </a>
                <h1 class="text-3xl font-bold text-text-primary">Audit Logs</h1>
            </div>
            <p class="text-text-secondary mt-1 ml-9">View and download WebZFS audit logs</p>
        </div>
    </div>

    {% if error %}
    <div class="card-nested bg-danger-900/30 border-danger-900">
        <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-danger-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
                <h3 class="text-danger-400 font-semibold">Error</h3>
                <p class="text-text-secondary">{{ error }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Log Directory Info -->
    <div class="card-nested bg-surface-700/50">
        <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
            </svg>
            <span class="text-text-secondary">Log Directory:</span>
            <code class="text-info-400 bg-surface-800 px-2 py-1 rounded text-sm">{{ log_dir }}</code>
        </div>
    </div>

    <!-- Log Files Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
        
        <!-- Authentication Log -->
        {% set auth_info = logs_info.get('auth', {}) %}
        <div class="card animate-fade-in">
            <div class="card-body">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-danger-500/10 border border-danger-500/20 rounded-lg">
                        <svg class="w-8 h-8 text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-text-primary">Authentication</h2>
                        <p class="text-sm text-text-secondary">auth.log</p>
                    </div>
                </div>
                
                <p class="text-text-secondary text-sm mb-4">
                    Login attempts, logout events, and rate limiting records.
                </p>
                
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Size:</span>
                        <span class="text-text-primary">{{ auth_info.get('info', {}).get('size_human', 'N/A') }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Entries:</span>
                        <span class="text-text-primary">{{ auth_info.get('info', {}).get('line_count', 0) }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Last Modified:</span>
                        <span class="text-text-primary">{{ auth_info.get('info', {}).get('modified', 'N/A') or 'N/A' }}</span>
                    </div>
                </div>
                
                <div class="mt-6 flex gap-2">
                    <a href="/utils/logs/view/auth" class="btn btn-primary flex-1">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        View
                    </a>
                    <a href="/utils/logs/download/auth" class="btn btn-outline" hx-boost="false">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- ZFS Operations Log -->
        {% set zfs_info = logs_info.get('zfs_operations', {}) %}
        <div class="card animate-fade-in" style="animation-delay: 0.1s;">
            <div class="card-body">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-primary-500/10 border border-primary-500/20 rounded-lg">
                        <svg class="w-8 h-8 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-text-primary">ZFS Operations</h2>
                        <p class="text-sm text-text-secondary">zfs_operations.log</p>
                    </div>
                </div>
                
                <p class="text-text-secondary text-sm mb-4">
                    Pool, dataset, and snapshot operations with user attribution.
                </p>
                
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Size:</span>
                        <span class="text-text-primary">{{ zfs_info.get('info', {}).get('size_human', 'N/A') }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Entries:</span>
                        <span class="text-text-primary">{{ zfs_info.get('info', {}).get('line_count', 0) }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Last Modified:</span>
                        <span class="text-text-primary">{{ zfs_info.get('info', {}).get('modified', 'N/A') or 'N/A' }}</span>
                    </div>
                </div>
                
                <div class="mt-6 flex gap-2">
                    <a href="/utils/logs/view/zfs_operations" class="btn btn-primary flex-1">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        View
                    </a>
                    <a href="/utils/logs/download/zfs_operations" class="btn btn-outline" hx-boost="false">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- File Access Log -->
        {% set file_info = logs_info.get('file_access', {}) %}
        <div class="card animate-fade-in" style="animation-delay: 0.2s;">
            <div class="card-body">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-info-500/10 border border-info-500/20 rounded-lg">
                        <svg class="w-8 h-8 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-text-primary">File Access</h2>
                        <p class="text-sm text-text-secondary">file_access.log</p>
                    </div>
                </div>
                
                <p class="text-text-secondary text-sm mb-4">
                    File read/write operations and directory listings.
                </p>
                
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Size:</span>
                        <span class="text-text-primary">{{ file_info.get('info', {}).get('size_human', 'N/A') }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Entries:</span>
                        <span class="text-text-primary">{{ file_info.get('info', {}).get('line_count', 0) }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-text-secondary">Last Modified:</span>
                        <span class="text-text-primary">{{ file_info.get('info', {}).get('modified', 'N/A') or 'N/A' }}</span>
                    </div>
                </div>
                
                <div class="mt-6 flex gap-2">
                    <a href="/utils/logs/view/file_access" class="btn btn-primary flex-1">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                        View
                    </a>
                    <a href="/utils/logs/download/file_access" class="btn btn-outline" hx-boost="false">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Shell Session History -->
        {% if cockpit_context %}
        <div class="card opacity-60 animate-fade-in" aria-disabled="true">
            <div class="card-body">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-bg-elevated-2 rounded-lg">
                        <svg class="w-8 h-8 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-text-secondary">Shell Session History</h2>
                        <span class="badge-secondary">Not available in Cockpit</span>
                    </div>
                </div>
                <p class="text-text-tertiary text-sm mb-0">WebZFS does not start, record, or expose terminal sessions inside Cockpit. Cockpit Terminal auditing must be configured separately.</p>
            </div>
        </div>
        {% elif not shell_history_allowed %}
        <div class="card opacity-60 animate-fade-in" aria-disabled="true">
            <div class="card-body">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-bg-elevated-2 rounded-lg">
                        <svg class="w-8 h-8 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-text-secondary">Shell Session History</h2>
                        <span class="badge-secondary">Audit access not granted</span>
                    </div>
                </div>
                <p class="text-text-tertiary text-sm mb-0">Your username is not included in the administrator-managed shell recording auditor allowlist.</p>
            </div>
        </div>
        {% else %}
        <div class="card animate-fade-in">
            <div class="card-body">
                <div class="flex items-center gap-3 mb-4">
                    <div class="p-3 bg-warning-500/10 border border-warning-500/20 rounded-lg">
                        <svg class="w-8 h-8 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-text-primary">Shell Session History</h2>
                        <span class="{% if shell_history.recording_enabled %}badge-warning{% else %}badge-secondary{% endif %}">{% if shell_history.recording_enabled %}Recording enabled{% else %}Recording disabled{% endif %}</span>
                    </div>
                </div>
                <div class="space-y-2 text-sm mb-6">
                    <div class="flex justify-between"><span class="text-text-secondary">Sessions:</span><span class="text-text-primary">{{ shell_history.session_count }}</span></div>
                    <div class="flex justify-between"><span class="text-text-secondary">Archive Size:</span><span class="text-text-primary">{{ shell_history.total_size_display }}</span></div>
                    <div class="flex justify-between"><span class="text-text-secondary">Integrity:</span><span class="{% if shell_history.all_valid and shell_history.ledger.valid %}text-success-400{% else %}text-danger-400{% endif %}">{% if shell_history.all_valid and shell_history.ledger.valid %}Verified{% else %}Attention required{% endif %}</span></div>
                </div>
                <a href="/utils/logs/shell-history" class="btn-primary w-full">View History</a>
            </div>
        </div>
        {% endif %}

    </div>

    <!-- Info Banner -->
    <div class="card-nested bg-info-900/30 border-info-900 animate-fade-in" style="animation-delay: 0.3s;">
        <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-info-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
                <h3 class="text-lg font-semibold text-info-400 mb-2">About Audit Logs</h3>
                <p class="text-text-secondary">
                    Audit logs are automatically maintained by WebZFS to track security-relevant events. 
                    Log files rotate automatically when they reach 10MB, with up to 5 backup files retained.
                    All timestamps are in server local time.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
