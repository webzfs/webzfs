{# Unified scheduling hub task table, loaded by HTMX #}

<!-- Summary counters -->
<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
    <div class="card">
        <div class="card-body py-4">
            <p class="text-text-tertiary text-xs uppercase tracking-wider">Total Tasks</p>
            <p class="text-2xl font-bold text-text-primary mt-1">{{ tasks|length }}</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-4">
            <p class="text-text-tertiary text-xs uppercase tracking-wider">Enabled</p>
            <p class="text-2xl font-bold text-success-400 mt-1">{{ enabled_count }}</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-4">
            <p class="text-text-tertiary text-xs uppercase tracking-wider">Scrubs</p>
            <p class="text-2xl font-bold text-text-primary mt-1">{{ counts.scrub }}</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-4">
            <p class="text-text-tertiary text-xs uppercase tracking-wider">SMART Tests</p>
            <p class="text-2xl font-bold text-text-primary mt-1">{{ counts.smart }}</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-4">
            <p class="text-text-tertiary text-xs uppercase tracking-wider">Replication</p>
            <p class="text-2xl font-bold text-text-primary mt-1">{{ counts.syncoid }}</p>
        </div>
    </div>
</div>

{% if tasks and tasks|length > 0 %}
<div class="card">
    <div class="card-body p-0">
        <div class="p-6 border-b border-border-subtle flex items-center justify-between">
            <h2 class="text-xl font-bold text-text-primary">Scheduled Tasks</h2>
            <div class="flex flex-wrap gap-2 text-sm">
                <a href="/utils/scheduling/scrub/new" class="text-primary-400 hover:text-primary-300">Add Scrub</a>
                <span class="text-text-tertiary">|</span>
                <a href="/utils/scheduling/smart/new" class="text-primary-400 hover:text-primary-300">Add SMART Test</a>
                <span class="text-text-tertiary">|</span>
                <a href="/utils/scheduling/health/new" class="text-primary-400 hover:text-primary-300">Add Health Check</a>
                <span class="text-text-tertiary">|</span>
                <a href="/zfs/replication/syncoid/jobs/create/form" class="text-primary-400 hover:text-primary-300">Add Replication Job</a>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead class="bg-bg-elevated-2 text-text-secondary">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Task</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Schedule</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Next Run</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Last Run</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-bg-elevated divide-y divide-border-subtle">
                    {% for task in tasks %}
                    <tr class="hover:bg-bg-elevated-2 transition-colors">
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if task.task_type == 'scrub' %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-success-900/40 text-success-400">Scrub</span>
                            {% elif task.task_type == 'smart' %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-warning-900/40 text-warning-400">SMART</span>
                            {% elif task.task_type == 'health' %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-info-900/40 text-info-400">Health</span>
                            {% else %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-900/40 text-purple-400">Replication</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-text-primary font-medium">{{ task.title }}</div>
                            <div class="text-text-tertiary text-xs mt-0.5">{{ task.detail }}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-text-secondary font-mono text-sm">{{ task.schedule }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-text-secondary text-sm">
                            {% if task.enabled and task.next_run %}{{ task.next_run }}{% else %}<span class="text-text-tertiary">-</span>{% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-text-secondary text-sm">
                            {% if task.last_run %}{{ task.last_run[:19]|replace('T', ' ') }}{% else %}<span class="text-text-tertiary">Never</span>{% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            {% if not task.enabled %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-bg-elevated-2 text-text-tertiary">Disabled</span>
                            {% elif task.registration_error %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-danger-900/40 text-danger-400">Registration error</span>
                            <div class="text-danger-400 text-xs mt-1 whitespace-normal max-w-sm">{{ task.registration_error }}</div>
                            {% elif task.last_status == 'success' %}
                            <span class="badge-success text-xs">Success</span>
                            {% elif task.last_status == 'failure' %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-danger-900/40 text-danger-400">Failure</span>
                            {% elif task.last_status %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-info-900/40 text-info-400">{{ task.last_status }}</span>
                            {% else %}
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-success-900/40 text-success-400">Enabled</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <div class="flex items-center space-x-3">
                                {% if task.manageable %}
                                <a href="/utils/scheduling/{{ task.task_type }}/{{ task.task_id }}/edit"
                                   class="text-primary-400 hover:text-primary-300" title="Edit Schedule">Edit</a>
                                <form method="post" action="/utils/scheduling/{{ task.task_type }}/{{ task.task_id }}/run" class="inline">
                                    <button type="submit" class="text-info-400 hover:text-info-300" title="Run Now">Run</button>
                                </form>
                                <form method="post" action="/utils/scheduling/{{ task.task_type }}/{{ task.task_id }}/toggle" class="inline">
                                    <button type="submit" class="text-warning-400 hover:text-warning-300" title="Toggle Enabled/Disabled">
                                        {% if task.enabled %}Disable{% else %}Enable{% endif %}
                                    </button>
                                </form>
                                <!--
                                    The delete post lives in a hidden form
                                    that the confirmation modal submits.
                                    Posting from the modal button with
                                    hx-post is not usable here: the delete
                                    route answers with a redirect, which
                                    HTMX would swap into the modal instead
                                    of navigating.
                                -->
                                <form method="post"
                                      action="/utils/scheduling/{{ task.task_type }}/{{ task.task_id }}/delete"
                                      id="form-delete-task-{{ task.task_type }}-{{ task.task_id }}"
                                      class="hidden"></form>
                                <button type="button" class="text-danger-400 hover:text-danger-300" title="Delete Schedule"
                                        onclick="showConfirm('modal-delete-task-{{ task.task_type }}-{{ task.task_id }}')">Delete</button>
                                {% else %}
                                <a href="{{ task.edit_url }}" class="text-primary-400 hover:text-primary-300" title="Manage on the Replication page">Manage</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modals -->
{% for task in tasks %}
    {% if task.manageable %}
    {% set id = 'modal-delete-task-' ~ task.task_type ~ '-' ~ task.task_id|string %}
    {% set title = 'Delete Scheduled Task' %}
    {% set message = 'Delete "' ~ task.title ~ '"? The operating system scheduler entry is removed as well.' %}
    {% set confirm_text = 'Delete' %}
    {% set confirm_class = 'danger' %}
    {% set confirm_action = 'document.getElementById("form-delete-task-' ~ task.task_type ~ '-' ~ task.task_id|string ~ '").submit()' %}
    {% include 'partials/confirm.jinja' %}
    {% endif %}
{% endfor %}

<script>
// Alpine 3 replacement for the helper shipped inside confirm.jinja, which
// only knows the Alpine 2 __x property. Alpine picks up the modals in this
// partial through its mutation observer after the HTMX swap, so the data
// has to be reached with Alpine.$data.
window.showConfirm = function(dialogId) {
    const dialog = document.getElementById(dialogId);
    if (!dialog) {
        console.error('Dialog not found:', dialogId);
        return;
    }
    if (window.Alpine) {
        const component = window.Alpine.$data(dialog);
        if (component) {
            component.open = true;
            return;
        }
    }
    if (dialog.__x) {
        dialog.__x.$data.open = true;
        return;
    }
    dialog.dispatchEvent(new CustomEvent('open-modal'));
};
</script>

{% else %}
<div class="card">
    <div class="card-body text-center py-12">
        <div class="text-text-tertiary mb-4">
            <svg class="mx-auto h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <h3 class="text-lg font-medium text-text-primary mb-2">No Scheduled Tasks</h3>
        <p class="text-text-secondary mb-4">Create a scrub, SMART test, health check, or replication schedule to automate maintenance.</p>
        <div class="flex flex-wrap justify-center gap-2">
            <a href="/utils/scheduling/scrub/new" class="btn-primary px-4 py-2 inline-block">New Scrub</a>
            <a href="/utils/scheduling/smart/new" class="btn-secondary px-4 py-2 inline-block">New SMART Test</a>
            <a href="/utils/scheduling/health/new" class="btn-secondary px-4 py-2 inline-block">New Health Check</a>
        </div>
    </div>
</div>
{% endif %}
