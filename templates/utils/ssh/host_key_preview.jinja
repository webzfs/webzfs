{#
  Host key fingerprint preview for the Add SSH Connection form.

  Rendered by POST /utils/ssh/scan-host-key into #host-key-preview.
  Nothing is pinned here. The hidden `fingerprint` inputs travel with
  the add form, binding the eventual pin to the exact key shown to the
  administrator, so the password is never sent to a host whose key the
  administrator did not approve.
#}
{% if error %}
  <div class="card-nested bg-danger-900/30 border-danger-900">
    <p class="text-sm text-danger-300">Host key scan failed: {{ error }}</p>
  </div>

{% elif not preview.scanned %}
  <div class="card-nested bg-danger-900/30 border-danger-900">
    <p class="text-sm text-danger-300">
      No host key could be retrieved from {{ preview.host }}:{{ preview.port }}.
      Check the host, the port, and that the server is reachable.
    </p>
  </div>

{% else %}
  <div class="card-nested {% if preview.is_changed %}bg-danger-900/30 border-danger-900{% else %}bg-info-500/10 border-info-500/30{% endif %}">
    {% if preview.is_changed %}
      <p class="text-sm font-medium text-danger-400 mb-2">
        Warning: a different key is already pinned for this host
      </p>
    {% endif %}

    <p class="text-sm text-text-secondary mb-2">
      Host key fingerprint for {{ preview.host }}:{{ preview.port }}:
    </p>

    <ul class="space-y-2 mb-3">
      {% for fp in preview.fingerprints %}
        <li class="font-mono text-xs text-text-primary break-all bg-bg-elevated-2 rounded px-3 py-2">
          {{ fp }}
        </li>
      {% endfor %}
    </ul>

    <p class="text-xs text-text-tertiary">
      Verify this out of band before submitting. On the server console run
      <span class="font-mono">ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub</span>.
      Submitting the form pins this exact key; if it changes in the meantime
      the connection is refused and no password is sent.
    </p>

    {% for fp in preview.fingerprints %}
      <input type="hidden" name="fingerprint" value="{{ fp }}">
    {% endfor %}
  </div>
{% endif %}
