{# zed.rc edit form loaded into the rc-modal via HTMX #}
<div class="mb-3 text-sm text-text-tertiary">
    <code class="font-mono text-primary-400">{{ rc_path }}</code>
</div>

<form method="post" action="/utils/zed/zed-rc" hx-boost="false">
    <input type="hidden" name="content_hash" value="{{ rc_hash }}">
    <div class="mb-4">
        <textarea name="content" rows="20" class="form-input w-full font-mono text-xs resize-y" style="tab-size:4">{{ rc_content }}</textarea>
    </div>
    <div class="flex justify-end gap-3">
        <button type="button" class="btn btn-secondary" onclick="closeZedModal('rc-modal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save zed.rc</button>
    </div>
</form>
