{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="space-y-6">
    {# Breadcrumb #}
    <nav class="text-sm text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">Utilities</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary font-medium">ZED Event Scripts</span>
    </nav>

    {# Page Header #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-bold text-text-primary">ZED Event Scripts</h1>
            <p class="text-text-secondary text-sm mt-1">Manage ZFS Event Daemon linkage scripts (ZEDLETs). Enable packaged handlers, create local event hooks, and safely override existing scripts.</p>
        </div>
    </div>

    {# Success/Error Messages #}
    {% if request.query_params.get('message') %}
    <div class="bg-success-900/30 border-2 border-success-500/50 text-success-400 px-4 py-3 rounded">
        {{ request.query_params.get('message') }}
    </div>
    {% endif %}

    {% if request.query_params.get('error') %}
    <div class="bg-danger-900/30 border-2 border-danger-500/50 text-danger-400 px-4 py-3 rounded">
        <strong>Error:</strong> {{ request.query_params.get('error') }}
    </div>
    {% endif %}

    {# HTMX deferred loading #}
    <div id="zed-content-container"
         hx-get="/utils/zed/content-partial"
         hx-trigger="load"
         hx-swap="innerHTML">
        <div class="flex flex-col items-center justify-center py-16">
            <svg class="animate-spin h-10 w-10 text-primary-400 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-text-secondary text-lg">Loading ZED configuration...</p>
            <p class="text-text-tertiary text-sm mt-1">Scanning ZED directories and daemon status.</p>
        </div>
    </div>

    {# Info Box #}
    <div class="bg-info-900/30 border-2 border-info-500/50 text-info-400 px-4 py-3 rounded">
        <strong>
            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            About ZEDLETs:
        </strong>
        <p class="mt-1 text-sm">ZEDLETs are scripts executed by the ZFS Event Daemon when ZFS events occur. Event selection is encoded in the filename. Scripts must be root-owned, owner-executable, and not group/other-writable. Package-provided scripts are symlinked from the installed directory; editing a package script creates a local override that can be restored to the original.</p>
    </div>
</div>
{% endblock %}
