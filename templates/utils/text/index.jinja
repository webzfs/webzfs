{% extends "layout.jinja" %}

{% set active_page = "utils" %}

{% block content %}
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">Utilities</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">Text Editor</span>
    </nav>

    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <h1 class="text-3xl font-bold text-text-primary mb-0">Text Editor</h1>
        <a href="/utils/files" class="btn-secondary inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
            </svg>
            Browse Files
        </a>
    </div>

    <div class="card mb-6 animate-fade-in">
        <div class="card-body">
            <div class="flex items-start gap-3 mb-5">
                <div class="p-2 bg-primary-500/10 border border-primary-500/20 rounded-lg flex-shrink-0">
                    <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-text-primary mb-1">Open a text file</h2>
                    <p class="text-sm text-text-secondary mb-0">Enter a server path to load its contents into the editor.</p>
                </div>
            </div>

            <form action="/utils/text/read" method="post" class="flex flex-col sm:flex-row sm:items-end gap-3">
                <div class="flex-1">
                    <label class="form-label" for="file_path">File Path</label>
                    <input
                        class="form-input font-mono"
                        id="file_path"
                        name="file_path"
                        type="text"
                        placeholder="/path/to/file.txt"
                        autocomplete="off"
                        required
                    >
                </div>
                <button
                    hx-post="/utils/text/read"
                    hx-target="#edit"
                    hx-swap="innerHTML"
                    class="btn-primary inline-flex items-center justify-center gap-2 sm:flex-shrink-0"
                    type="submit"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Open File
                </button>
            </form>
        </div>
    </div>

    <!-- Common File Paths Section -->
    <div class="card mb-6 animate-fade-in">
        <div class="card-body">
        <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Common Configuration Files
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <button 
                type="button"
                onclick="document.getElementById('file_path').value='/etc/fstab'"
                class="card-nested flex items-center gap-3 text-left hover:border-primary-500 transition-colors"
            >
                <svg class="w-5 h-5 text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
                </svg>
                <div>
                    <div class="text-sm font-medium text-text-primary">/etc/fstab</div>
                    <div class="text-xs text-text-tertiary">Filesystem mounts</div>
                </div>
            </button>
            <button 
                type="button"
                onclick="document.getElementById('file_path').value='/etc/hosts'"
                class="card-nested flex items-center gap-3 text-left hover:border-primary-500 transition-colors"
            >
                <svg class="w-5 h-5 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                <div>
                    <div class="text-sm font-medium text-text-primary">/etc/hosts</div>
                    <div class="text-xs text-text-tertiary">Host resolution</div>
                </div>
            </button>
            <button 
                type="button"
                onclick="document.getElementById('file_path').value='/etc/ssh/sshd_config'"
                class="card-nested flex items-center gap-3 text-left hover:border-primary-500 transition-colors"
            >
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <div>
                    <div class="text-sm font-medium text-text-primary">/etc/ssh/sshd_config</div>
                    <div class="text-xs text-text-tertiary">SSH daemon config</div>
                </div>
            </button>
            <button 
                type="button"
                onclick="document.getElementById('file_path').value='/etc/resolv.conf'"
                class="card-nested flex items-center gap-3 text-left hover:border-primary-500 transition-colors"
            >
                <svg class="w-5 h-5 text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                </svg>
                <div>
                    <div class="text-sm font-medium text-text-primary">/etc/resolv.conf</div>
                    <div class="text-xs text-text-tertiary">DNS resolution</div>
                </div>
            </button>
        </div>
        </div>
    </div>

    <!-- Editor Container -->
    <div id="edit" class="w-full scroll-mt-6"></div>
{% endblock %}
