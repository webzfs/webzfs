{% if success %}
<div class="alert-success flex items-center gap-3 mb-4 animate-fade-in" role="status">
    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    </svg>
    <span>File saved successfully.</span>
</div>
{% endif %}

{% if error %}
    {% include "partials/error.jinja" %}
{% endif %}

<!-- Text Editor Card -->
<div class="card">
    <div class="card-body">
        <div class="flex flex-wrap items-start justify-between gap-3 mb-5 pb-5 border-b border-border-subtle">
            <div class="min-w-0">
                <h3 class="text-lg font-semibold text-text-primary flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Text Editor
                </h3>
                <p class="text-sm text-text-secondary font-mono mt-1 mb-0 break-all">{{ file_path }}</p>
            </div>
            <span class="badge-info">Plain text</span>
        </div>

        <form class="w-full" action="/utils/text/save" method="post">
            <input type="hidden" name="file_path" value="{{ file_path }}">
            
            <div class="mb-4">
                <label class="form-label" for="content">File Contents</label>
                <textarea
                    class="form-textarea font-mono text-sm leading-6 min-h-[32rem] scrollbar-thin"
                    id="content" 
                    name="content" 
                    rows="24"
                    placeholder="File content..."
                >{{ content }}</textarea>
                <p class="text-xs text-text-tertiary mt-2 mb-0">Saving replaces the current file contents.</p>
            </div>

            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
                <button
                    onclick="document.getElementById('edit').innerHTML = ''"
                    class="btn-secondary inline-flex items-center justify-center gap-2"
                    type="button"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    Close
                </button>
                <button
                    hx-post="/utils/text/save"
                    hx-target="#edit"
                    hx-swap="innerHTML"
                    class="btn-success inline-flex items-center justify-center gap-2"
                    type="submit"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                    </svg>
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
