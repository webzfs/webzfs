{# Single-disk discovery diff modal. Context: pool, node, selected, rows, device, base_url. #}
{% set close = "open = false; document.getElementById('vdev-modal-container').innerHTML = ''" %}
<div id="vdev-discovery-modal" class="modal-overlay" x-data="{ open: true }" x-show="open" x-on:keydown.escape.window="{{ close }}">
  <div class="fixed inset-0 bg-black/80 backdrop-blur-sm" x-on:click="{{ close }}"></div>
  <div class="fixed inset-0 z-50 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="modal modal-lg w-full max-w-3xl" x-on:click.stop>

        <div class="flex items-start justify-between gap-4 mb-3 pb-3 border-b border-border-subtle">
          <div class="min-w-0">
            <h3 class="text-lg font-semibold text-text-primary mb-0">Discovered Hardware Metadata</h3>
            <p class="text-xs text-text-tertiary mt-1 mb-0 break-all">{{ node.name }} / probed <code>{{ device }}</code> with <code>smartctl -i</code>. Blank fields are selected by default; mismatched saved values require an explicit choice.</p>
          </div>
          <button type="button" class="text-text-secondary hover:text-text-primary rounded-lg p-1.5 transition-colors flex-shrink-0" x-on:click="{{ close }}" aria-label="Close">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <form method="post" action="{{ base_url }}/discover/apply" hx-boost="false">
          <input type="hidden" name="pool" value="{{ pool }}">
          <input type="hidden" name="selected" value="{{ selected }}">

          <div class="table-container">
            <table class="table text-sm">
              <thead class="table-header">
                <tr>
                  <th class="table-header-cell px-3 py-2">Apply</th>
                  <th class="table-header-cell px-3 py-2">Property</th>
                  <th class="table-header-cell px-3 py-2">Saved</th>
                  <th class="table-header-cell px-3 py-2">Discovered</th>
                  <th class="table-header-cell px-3 py-2">Action</th>
                </tr>
              </thead>
              <tbody>
                {% for row in rows %}
                <tr class="table-row">
                  <td class="px-3 py-2">
                    {% if row.action in ('fill', 'review') %}
                    <input type="checkbox" name="apply" value="{{ row.key }}" class="form-checkbox" {% if row.action == 'fill' %}checked{% endif %}>
                    <input type="hidden" name="value:{{ row.key }}" value="{{ row.discovered }}">
                    {% endif %}
                  </td>
                  <td class="px-3 py-2 text-text-primary">{{ row.label }}<code class="block text-[9.5px] text-text-tertiary bg-transparent px-0">{{ row.key }}</code></td>
                  <td class="px-3 py-2 font-mono text-xs break-all {% if row.saved %}text-text-primary{% else %}text-text-tertiary italic{% endif %}">{{ row.saved or 'blank' }}</td>
                  <td class="px-3 py-2 font-mono text-xs break-all {% if row.discovered %}text-text-primary{% else %}text-text-tertiary italic{% endif %}">{{ row.discovered or 'not reported' }}</td>
                  <td class="px-3 py-2">
                    {% if row.action == 'fill' %}<span class="badge badge-info">fill</span>
                    {% elif row.action == 'review' %}<span class="badge badge-warning">review</span>
                    {% elif row.action == 'unchanged' %}<span class="badge badge-success">unchanged</span>
                    {% else %}<span class="badge badge-secondary">unavailable</span>{% endif %}
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          <p class="text-xs text-text-tertiary mt-3 mb-0">Discovery never overwrites administrator-entered values unless you select a <span class="text-warning-400">review</span> row. Each applied value runs one <code>zpool set</code> against {{ node.name }}.</p>

          <div class="flex justify-end gap-2 pt-4 mt-4 border-t border-border-subtle">
            <button type="button" class="btn-secondary" x-on:click="{{ close }}">Cancel</button>
            <button type="submit" class="btn-info">Apply Selected</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
