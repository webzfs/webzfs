{# Bulk "Discover Blank Metadata" plan modal. Fills blank values only. Context: pool, selected, plan, errors, base_url. #}
{% set close = "open = false; document.getElementById('vdev-modal-container').innerHTML = ''" %}
<div id="vdev-bulk-discovery-modal" class="modal-overlay" x-data="{ open: true }" x-show="open" x-on:keydown.escape.window="{{ close }}">
  <div class="fixed inset-0 bg-black/80 backdrop-blur-sm" x-on:click="{{ close }}"></div>
  <div class="fixed inset-0 z-50 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="modal modal-lg w-full max-w-4xl" x-on:click.stop>

        <div class="flex items-start justify-between gap-4 mb-3 pb-3 border-b border-border-subtle">
          <div>
            <h3 class="text-lg font-semibold text-text-primary mb-0">Discover Blank Metadata</h3>
            <p class="text-xs text-text-tertiary mt-1 mb-0">Pool {{ pool }}: every leaf vdev was probed with <code>smartctl -i</code>. Only blank properties are listed; saved values are never replaced by this action.</p>
          </div>
          <button type="button" class="text-text-secondary hover:text-text-primary rounded-lg p-1.5 transition-colors flex-shrink-0" x-on:click="{{ close }}" aria-label="Close">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        {% if errors %}
        <div class="bg-warning-900/30 border border-warning-500/40 text-warning-400 text-xs px-3 py-2 rounded mb-3">
          <p class="font-medium mb-1 text-warning-400">{{ errors|length }} leaf vdev{{ 's' if errors|length != 1 else '' }} could not be probed</p>
          <ul class="list-disc ml-4 space-y-0.5 text-text-secondary">
            {% for item in errors %}<li><span class="font-mono text-text-primary">{{ item.pool }}/{{ item.leaf }}</span>: {{ item.error }}</li>{% endfor %}
          </ul>
        </div>
        {% endif %}

        <form method="post" action="{{ base_url }}/discover-all/apply" hx-boost="false">
          <input type="hidden" name="pool" value="{{ pool }}">
          <input type="hidden" name="selected" value="{{ selected }}">

          {% if plan %}
          <div class="table-container max-h-[55vh] overflow-y-auto scrollbar-thin">
            <table class="table text-sm">
              <thead class="table-header sticky top-0">
                <tr>
                  <th class="table-header-cell px-3 py-2">Apply</th>
                  <th class="table-header-cell px-3 py-2">Leaf vdev</th>
                  <th class="table-header-cell px-3 py-2">Property</th>
                  <th class="table-header-cell px-3 py-2">Discovered value</th>
                </tr>
              </thead>
              <tbody>
                {% for row in plan %}
                {% set token = row.pool ~ '|' ~ row.leaf ~ '|' ~ row.key %}
                <tr class="table-row">
                  <td class="px-3 py-2">
                    <input type="checkbox" name="apply" value="{{ token }}" class="form-checkbox" checked>
                    <input type="hidden" name="value:{{ token }}" value="{{ row.discovered }}">
                  </td>
                  <td class="px-3 py-2 font-mono text-xs text-text-primary break-all">{{ row.pool }}/{{ row.leaf }}</td>
                  <td class="px-3 py-2 text-text-primary">{{ row.label }}<code class="block text-[9.5px] text-text-tertiary bg-transparent px-0">{{ row.key }}</code></td>
                  <td class="px-3 py-2 font-mono text-xs text-text-primary break-all">{{ row.discovered }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <p class="text-xs text-text-tertiary mt-3 mb-0">{{ plan|length }} blank value{{ 's' if plan|length != 1 else '' }} ready to write. Each runs one <code>zpool set</code>; the page re-reads ZFS afterward.</p>
          {% else %}
          <div class="card-nested text-sm text-text-secondary">No blank discoverable values were found. All probed leaf vdevs already have model, serial, WWN, firmware, interface, and form factor where the hardware reports them.</div>
          {% endif %}

          <div class="flex justify-end gap-2 pt-4 mt-4 border-t border-border-subtle">
            <button type="button" class="btn-secondary" x-on:click="{{ close }}">{{ 'Cancel' if plan else 'Close' }}</button>
            {% if plan %}<button type="submit" class="btn-info">Write Selected Values</button>{% endif %}
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
