{# Warning for a pool that cannot store custom vdev properties. Context: pool_name, reason, upgradable. #}
<div class="alert alert-warning flex items-start gap-3">
    <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <div class="text-sm space-y-2 min-w-0">
        <div class="font-semibold">Pool {{ pool_name }} is incompatible with custom vdev properties</div>
        <div class="text-text-secondary">{{ reason }}</div>
        {% if upgradable %}
        <div class="text-text-secondary">
            Run <code class="font-mono">zpool upgrade {{ pool_name }}</code> on the command line to upgrade the pool.
            A pool upgrade is a one-way operation: an upgraded pool cannot be imported on a system running an older OpenZFS version.
        </div>
        <div>
            <a href="/zfs/pools/{{ pool_name|urlencode }}#pool-upgrade" class="underline hover:text-warning-300">View the pool version and the features an upgrade enables</a>
        </div>
        {% endif %}
    </div>
</div>
