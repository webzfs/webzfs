{% extends "layout.jinja" %}

{% set active_page = "utils" %}

{% block content %}
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">Utilities</a>
        <span class="mx-2">/</span>
        <a href="/utils/files" class="hover:text-primary-400">File Browser</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary font-mono">{{ directory }}</span>
    </nav>

    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <h1 class="text-3xl font-bold text-text-primary mb-0">File Browser</h1>
        <div class="flex flex-wrap gap-2">
            <a href="/utils/files" class="btn-secondary inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                New Location
            </a>
            <a href="/utils/text" class="btn-secondary inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Text Editor
            </a>
        </div>
    </div>

    <div class="card mb-6 animate-fade-in">
        <div class="card-body">
            <form action="/utils/files/list" method="post" class="flex flex-col sm:flex-row sm:items-end gap-3">
                <div class="flex-1">
                    <label class="form-label" for="directory">Directory Path</label>
                    <input class="form-input font-mono" id="directory" name="directory" type="text" value="{{ directory }}" autocomplete="off" required>
                </div>
                <button class="btn-primary inline-flex items-center justify-center gap-2 sm:flex-shrink-0" type="submit">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    Browse
                </button>
            </form>
        </div>
    </div>

    <div class="card animate-fade-in">
        <div class="card-body border-b border-border-subtle">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-text-primary mb-1 flex items-center gap-2">
                        <svg class="w-6 h-6 text-info-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                        </svg>
                        Directory Contents
                    </h2>
                    <p class="text-sm text-text-secondary font-mono mb-0 break-all">{{ directory }}</p>
                </div>
                <div class="flex items-center gap-2">
                    {% if directory != "/" %}
                    <form action="/utils/files/list" method="post">
                        <input type="hidden" name="directory" value="{{ directory.rsplit('/', 1)[0] or '/' }}">
                        <button type="submit" class="btn-secondary btn-sm inline-flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            Parent
                        </button>
                    </form>
                    {% endif %}
                    <span class="badge-secondary">{{ files|length }} item{% if files|length != 1 %}s{% endif %}</span>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead>
                    <tr class="bg-bg-elevated-2">
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            Name
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            Type
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            Size
                        </th>
                        <th class="hidden lg:table-cell px-6 py-3 text-left text-xs font-medium text-text-secondary uppercase tracking-wider">
                            Modified
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-text-secondary uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle">
                    {% if files %}
                        {% for file in files %}
                        <tr class="hover:bg-bg-elevated-2 transition-colors">
                            <td class="px-6 py-4 min-w-[16rem]">
                                <div class="flex items-center gap-2 min-w-0">
                                    {% if file.is_dir %}
                                    <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                                    </svg>
                                    {% else %}
                                    <svg class="w-5 h-5 text-text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                    </svg>
                                    {% endif %}
                                    <span class="text-sm text-text-primary font-medium truncate" title="{{ file.path }}">{{ file.name }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if file.is_dir %}
                                <span class="badge-info">Directory</span>
                                {% else %}
                                <span class="badge-secondary">File</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-text-secondary">
                                {% if not file.is_dir %}
                                {{ file.size_display }}
                                {% else %}
                                <span class="text-text-tertiary">—</span>
                                {% endif %}
                            </td>
                            <td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap text-sm text-text-secondary font-mono">
                                {{ file.modified_display }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                                {% if file.is_dir %}
                                <form action="/utils/files/list" method="post" class="inline">
                                    <input type="hidden" name="directory" value="{{ file.path }}">
                                    <button type="submit" class="btn-info btn-sm inline-flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                                        </svg>
                                        Open
                                    </button>
                                </form>
                                {% else %}
                                <form action="/utils/files/read" method="post" class="inline">
                                    <input type="hidden" name="file_path" value="{{ file.path }}">
                                    <button type="submit" class="btn-primary btn-sm inline-flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                        Edit
                                    </button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center">
                                <div class="flex flex-col items-center justify-center">
                                    <svg class="w-16 h-16 text-text-tertiary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                                    </svg>
                                    <p class="text-text-secondary text-lg font-medium mb-1">Directory is empty</p>
                                    <p class="text-text-tertiary text-sm">This directory contains no files or subdirectories</p>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
