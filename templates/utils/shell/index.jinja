{% extends "layout.jinja" %}

{% set active_page = "utils" %}

{% block title %}Shell Terminal - WebZFS{% endblock %}

{% block head_assets %}
{% if not cockpit_context and allowed %}
<link rel="stylesheet" href="{{ url_for('static', path='vendor/xterm/xterm.css') }}">
<script src="{{ url_for('static', path='vendor/xterm/xterm.js') }}"></script>
<script src="{{ url_for('static', path='vendor/xterm/addon-fit.js') }}"></script>
{% endif %}
{% endblock %}

{% block content %}
<nav class="text-sm mb-6 text-text-tertiary">
    <a href="/utils" class="hover:text-primary-400">Utilities</a>
    <span class="mx-2">/</span>
    <span class="text-text-primary">Shell Terminal</span>
</nav>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <h1 class="text-3xl font-bold text-text-primary mb-0">Shell Terminal</h1>
    <div class="flex flex-wrap gap-2">
        <form method="post" action="/utils/files/list">
            <input type="hidden" name="directory" value="{{ identity.home }}">
            <button type="submit" class="btn-secondary inline-flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                </svg>
                Browse Files
            </button>
        </form>
        <a href="/utils/logs" class="btn-secondary inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Audit Logs
        </a>
    </div>
</div>

{% if cockpit_context %}
<div class="card opacity-75 animate-fade-in" aria-disabled="true">
    <div class="card-body text-center py-12">
        <svg class="w-14 h-14 mx-auto text-text-tertiary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span class="badge-secondary mb-4">Not available in Cockpit</span>
        <h2 class="text-2xl font-semibold text-text-primary mt-4">Use Cockpit Terminal</h2>
        <p class="text-text-secondary max-w-2xl mx-auto">WebZFS disables its own terminal inside Cockpit. Cockpit Terminal opens a shell as your Cockpit user and is the supported shell interface in this environment.</p>
        <button type="button" class="btn-primary inline-flex items-center gap-2" onclick="WebZFSApp.openCockpitTerminal()">Open Cockpit Terminal</button>
    </div>
</div>
{% elif not allowed %}
<div class="card opacity-75 animate-fade-in" aria-disabled="true">
    <div class="card-body text-center py-12">
        <svg class="w-14 h-14 mx-auto text-text-tertiary mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <span class="badge-secondary mb-4">Access not granted</span>
        <h2 class="text-2xl font-semibold text-text-primary mt-4">Terminal access is restricted</h2>
        <p class="text-text-secondary max-w-2xl mx-auto">The authenticated username <code>{{ username }}</code> is not included in <code>SHELL_ALLOWED_USERS</code>. An administrator must update <code>/opt/webzfs/.env</code> and restart WebZFS.</p>
    </div>
</div>
{% else %}
{% if recording_enabled %}
<div class="alert-warning mb-4 animate-fade-in" role="alert">
    <div class="flex items-start gap-3">
        <svg class="w-6 h-6 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div>
            <h2 class="text-lg font-semibold text-warning-400">Terminal recording is enabled</h2>
            <p class="text-warning-400/90 text-sm mb-0">All terminal input, including passwords and other hidden input, terminal output, timing information, and resize events are archived for auditing. Recordings are retained for {{ recording_retention_days }} days with a {{ recording_max_session_mib }} MiB per-session limit.</p>
        </div>
    </div>
</div>
{% endif %}

<div class="card animate-fade-in">
    <div class="card-body p-0 overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-b border-border-subtle bg-bg-elevated-2">
            <div class="flex flex-wrap items-center gap-2 text-sm">
                <span id="terminal-status" class="badge-secondary">Disconnected</span>
                {% if recording_enabled %}<span class="badge-warning">Recording</span>{% endif %}
                <span class="text-text-secondary">WebZFS user: <strong class="text-text-primary">{{ username }}</strong></span>
                <span class="text-text-secondary">Effective account: <strong class="text-warning-400">{{ identity.username }} (UID {{ identity.uid }})</strong></span>
            </div>
            <div class="flex gap-2">
                <button id="terminal-reconnect" type="button" class="btn-secondary btn-sm">Reconnect</button>
                <button id="terminal-clear" type="button" class="btn-secondary btn-sm">Clear Screen</button>
                <button id="terminal-disconnect" type="button" class="btn-danger btn-sm">Disconnect</button>
            </div>
        </div>

        {% if recording_enabled %}
        <div id="terminal-consent" class="p-6 border-b border-border-subtle bg-bg-elevated">
            <label class="flex items-start gap-3 cursor-pointer">
                <input id="recording-acknowledgement" type="checkbox" class="form-checkbox mt-1">
                <span class="text-sm text-text-secondary">I understand that this session records all terminal input, including passwords and hidden input, plus output and timing information.</span>
            </label>
            <button id="terminal-start" type="button" class="btn-warning mt-4" disabled>Start Recorded Terminal</button>
        </div>
        {% endif %}

        <div id="terminal-container" class="bg-black min-h-[34rem] h-[calc(100vh-20rem)] p-3"></div>
    </div>
</div>

<div class="card-nested mt-4">
    <p class="text-sm text-text-secondary mb-0">The terminal runs as <strong class="text-warning-400">{{ identity.username }}</strong>, not as the PAM username shown above. It closes after {{ idle_timeout_seconds // 60 }} minutes without terminal activity or when the WebZFS login token expires.</p>
</div>

<script id="terminal-config" type="application/json">{{ {
    "recording": recording_enabled,
    "socketPath": "/utils/shell/terminal"
} | tojson }}</script>
<script src="{{ url_for('static', path='js/terminal/shell-terminal.js') }}"></script>
{% endif %}
{% endblock %}