CAPTION="webzfs 0.87.17-sec BETA3"
# SECRET_KEY signs every login session. Anyone who knows it can sign a session
# for any username without a password. The installers replace the placeholder
# below with a generated 64 character key. WebZFS refuses to start when the
# key is a known placeholder or shorter than 32 characters. To generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_ME_GENERATE_NEW_KEY"
AUTH_SESSION_EXPIRES_SECONDS=36000

# Login restriction
#
# ==========================================================================
# WARNING: RESTRICT_LOGIN IS OFF BY DEFAULT DURING THE BETA / RC PHASE.
#
# With RESTRICT_LOGIN=no, EVERY account on this system that PAM accepts can
# log in to WebZFS: every local user with a password, and every directory
# user if PAM uses LDAP or SSSD. A WebZFS login is root-level control of this
# host on every platform. WebZFS runs as root on FreeBSD and NetBSD, and the
# Linux service account holds a sudo policy that is root-equivalent (the file
# browser and text editor alone can read and write any file on the system).
# The shell, delegation and recording allowlists below limit which pages a
# user sees; they do not limit privilege.
#
# Set RESTRICT_LOGIN=yes now unless you are certain that every account on
# this machine should be able to administer it. The 1.0 release will ship
# with this restriction enabled by default.
# ==========================================================================
#
# With RESTRICT_LOGIN=yes, an account may log in only if it is:
#   - one of the users listed in LOGIN_ALLOWED_USERS, or
#   - a member of a group listed in LOGIN_ALLOWED_GROUPS.
# Both lists are comma-separated; an account matching either list may log in.
#
# Groups:
#   webzfs-admin  Created by the installer for WebZFS administrators. It
#                 starts empty. Add an account with:
#                   Linux:          usermod -aG webzfs-admin <user>
#                   FreeBSD:        pw groupmod webzfs-admin -m <user>
#                   NetBSD:         add <user> to the webzfs-admin line in
#                                   /etc/group (members are comma-separated)
#   wheel         The traditional administrators group on FreeBSD, NetBSD and
#                 some Linux distributions. It does not exist on every Linux
#                 distribution (Debian and Ubuntu use "sudo" instead); a group
#                 that does not exist is ignored.
#
# Changes take effect after restarting WebZFS. With RESTRICT_LOGIN=yes,
# removing an account from these lists or groups also ends its existing
# sessions within about a minute. Keep at least one account you can log in
# with in a list before enabling this.
RESTRICT_LOGIN=no
LOGIN_ALLOWED_USERS=root
LOGIN_ALLOWED_GROUPS=wheel,webzfs-admin

# Native WebZFS terminal access
# Comma-separated PAM usernames. Leave empty to disable the terminal.
SHELL_ALLOWED_USERS=

# PAM users allowed to manage ZFS delegation through the native Utilities page.
# Comma-separated; empty disables access. Restart WebZFS after changing this.
# This application allowlist does not narrow the operating-system sudo policy.
ZFS_DELEGATION_ALLOWED_USERS=
SHELL_IDLE_TIMEOUT_SECONDS=1800

# Optional full terminal recording. Recorded input includes passwords and other
# hidden terminal input. Auditor usernames are comma-separated.
SHELL_RECORDING_ENABLED=false
SHELL_RECORDING_AUDIT_USERS=
SHELL_RECORDING_RETENTION_DAYS=30
SHELL_RECORDING_MAX_SESSION_MIB=100
SHELL_RECORDING_MAX_TOTAL_MIB=1024

# Server Configuration
# Port 26619: Z(26th letter) F(6th letter) S(19th letter) = ZFS
# BIND_IP: IP address to bind the server to (default: 127.0.0.1 for localhost only)
#          Use 0.0.0.0 to allow access from all network interfaces
BIND_IP=127.0.0.1
PORT=26619

# Reverse Proxy Configuration (optional)
# Comma-separated IP addresses or CIDR networks allowed to supply trusted
# X-Forwarded-Proto and X-Forwarded-For headers. Loopback is sufficient when
# the proxy runs on this host. If the proxy connects from another host or a
# container network, add only that proxy's address or network, for example:
#   FORWARDED_ALLOW_IPS=127.0.0.1,::1,172.18.0.0/16
# The login rate limiter uses the client address resolved from this setting.
# If a remote proxy is not listed, every user behind it shares the proxy's
# address, so 5 failed logins from anyone lock out everyone for a minute.
# Never use "*" on a network-reachable listener.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Unix Socket Configuration (optional, for reverse proxy setups)
# Use BIND instead of BIND_IP/PORT to listen on a unix socket
# Example: BIND=unix:/run/webzfs/webzfs.sock
# BIND=
#
# Socket file permissions (umask) - only applies when using unix sockets
# 0o007 = owner and group can access (default, recommended for reverse proxy)
# 0o077 = owner only (most restrictive)
# 0o000 = world readable/writable (not recommended)
# SOCKET_UMASK=0o007

# Email Notification Settings
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=webzfs@localhost
SMTP_NOTIFY_ON_SUCCESS=false
NOTIFICATION_RECIPIENTS=admin@example.com

# Audit Logging Settings
# Logs are stored in ~/.config/webzfs/logs/
# Four log files are created:
#   - auth.log: Authentication attempts (login/logout, rate limiting)
#   - zfs_operations.log: ZFS operations (pools, datasets, snapshots)
#   - file_access.log: File system access (read/write operations)
#   - shell_sessions.log: Terminal lifecycle metadata, restricted to shell auditors
# Log files rotate automatically at 10MB with 5 backup files kept
